Usage: ema inspect <root-pkg>

Inspect a schema package: print its dependency graph and topological ordering
(CLI wrapper over src/sort_schemas.php).
HELP
}

_cmd_inspect() {
    if _is_help "$@"; then
        _help_inspect
        return
    fi
    local root_pkg="${1:-}"
    if [[ -z "$root_pkg" ]]; then
        echo "Error: must provide a root package (e.g., ema inspect mypkg-HASH)" >&2
