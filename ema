    local root_pkg="${1:-}"
    if [[ -z "$root_pkg" ]]; then
        echo "Error: must provide a root package (e.g., ema deps mypkg-HASH)" >&2
        _help_deps
        exit 1
    fi
    _assert_repo_root
    if ! _find_package "$root_pkg" >/dev/null; then
        echo "Error: schema package '$root_pkg' not found" >&2
        exit 1
    fi
    php -r "
        require '${_EMA_LIB}/sort_schemas.php';
        echo implode(PHP_EOL, build_dependency_graph('${root_pkg}')->topological_sort()), PHP_EOL;
    "
}

if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

case "$1" in
    schema)
