#!/bin/bash

# Resolve the real location of this script so _EMA_LIB self-locates whether
# run in-tree, or via the Composer `vendor/bin/ema` symlink. EMA_LIB (env)
# still wins when set.
_EMA_SELF="$(readlink -f "${BASH_SOURCE[0]}")"
_EMA_LIB="${EMA_LIB:-$(cd "$(dirname "${_EMA_SELF}")" && pwd)/src}"

PROGRAM_NAME="ema"

# Parse state, populated by _parse_flags (one command invocation at a time).
declare -a _POS_ARGS=()
declare -a _FLAGS=()
declare -A _OPTIONS=()

show_help() {
    cat <<HELP
Usage: $PROGRAM_NAME <command> [arguments]

Database lifecycle & shell:
  sandbox srv/<name>-<GUID>   Build/reapply a per-instance sandbox for a database
  sandbox pkg/<pkg>-<GUID>    Build/reapply a sandbox for a schema package
  mariadb <db> [args...]      Open a MariaDB shell against a database's section
  start [<name>-<GUID>]       Start sandbox instance(s) (var/sandbox)
  stop [<name>-<GUID>]        Stop sandbox instance(s)
  restart [<name>-<GUID>]     Restart sandbox instance(s)
  status                      List instances/sections: up/down + endpoint + age
  drop <db>                   Drop a database (sandbox: confirmed; prod: --force)
  gc                          Remove stopped sandbox instances under var/sandbox

Schema packages:
  schema <name>               Create a new schema package in pkg/
  database <name>             Create srv/<name>-<GUID>/ package (default definition)
  inspect <root-pkg>          Show the schema dependency graph
  deps <root-pkg>             List schema packages in topological order

Options:
  -h, --help             Show this help message and exit
  -v, --version          Show program version

Run '$PROGRAM_NAME <command> --help' for per-command help.

Environment:
  EMA_TARGET             sandbox (default) or prod — binary connection flag
  REUTER_INI             Prod reuter.ini path (used when EMA_TARGET=prod)
  DBUSER                 Default CLI client user for non-local targets (default: \$USER)
  EMA_FORCE/EMA_QUIET/EMA_VERBOSE/EMA_NO_SHELL
                         Env fallbacks for the -f/-q/-v/-n flags
HELP
}

show_version() {
    echo "$PROGRAM_NAME version 1.0.0"
}

_assert_repo_root() {
    if [[ ! -d "pkg" ]]; then
        echo "Error: pkg/ not found — run ema from your project root" >&2
        exit 1
    fi
}

# Resolve a schema package dir via sort_schemas.php's find_package().
# Prints the absolute dir on success (return 0); prints nothing and returns 1
# when the package is absent from every root (local pkg/ or an installed
# Composer provider's pkg/).
_find_package() {
    local schema="$1"
    php -r "
        require '${_EMA_LIB}/sort_schemas.php';
        \$dir = find_package('${schema}');
        if (\$dir !== null) { echo \$dir; exit(0); }
        exit(1);
    "
}

# --- target & connection resolution -----------------------------------------
# EMA_TARGET is a binary sandbox/prod flag telling ema whether the connection
# is a sandbox database or a prod database. It is NOT a connection-file
# selector: prod file resolution stays a separate env (REUTER_INI), and sandbox
# resolution is per-instance under var/sandbox/<name>-<guid>/.
_target() {
    case "${EMA_TARGET:-}" in
        ""|sandbox) echo "sandbox" ;;
        prod) echo "prod" ;;
        *) echo "Error: EMA_TARGET must be 'sandbox' or 'prod' (got '${EMA_TARGET}')" >&2; exit 1 ;;
    esac
}

_is_sandbox() { [[ "$(_target)" == "sandbox" ]]; }

# Normalize a target ref (<name>-<GUID>, or an srv/... or pkg/... path) to the
# bare instance key <name>-<GUID>.
_instance_key() {
    local ref="${1:-}"
    echo "${ref##*/}"
}

# Split <name>-<GUID> into <name>. GUIDs are 16 chars (2-char type prefix +
# 14 base36), so the name is everything before the trailing '-<16 chars>'.
_instance_name() {
    local key="${1:-}"
    echo "${key%-${key: -16}}"
}

# Per-instance sandbox paths (var/sandbox/<name>-<guid>/).
_sandbox_dir()  { echo "var/sandbox/$1"; }
_sandbox_data() { echo "var/sandbox/$1/data"; }
_sandbox_pid()  { echo "var/sandbox/$1/mysql.pid"; }
_sandbox_sock() { echo "var/sandbox/$1/mysql.sock"; }
_sandbox_ini()  { echo "var/sandbox/$1/reuter.ini"; }

# Resolve an instance key from a ref (a bare dbname, or a full <name>-<GUID>).
# Prints the key; returns 1 when no instance exists; errors on ambiguity.
_resolve_instance() {
    local ref="${1:-}" key dirs
    key="$(_instance_key "$ref")"
    if [[ -d "var/sandbox/$key" ]]; then
        echo "$key"
        return 0
    fi
    mapfile -t dirs < <(ls -d "var/sandbox/${key}"-*/ 2>/dev/null)
    if [[ ${#dirs[@]} -eq 1 ]]; then
        basename "${dirs[0]}"
        return 0
    fi
    if [[ ${#dirs[@]} -gt 1 ]]; then
        echo "Error: multiple sandboxes match '$ref' (use a full <name>-<GUID>)" >&2
        return 1
    fi
    return 1
}

# The connection file for a database:
#   sandbox -> the per-instance var/sandbox/<name>-<guid>/reuter.ini
#   prod    -> $REUTER_INI (fallback etc/reuter.ini)
_reuter_file() {
    local dbname="${1:-}"
    if _is_sandbox; then
        local key
        key="$(_resolve_instance "$dbname")" || exit 1
        if [[ -z "$key" ]]; then
            echo "Error: no sandbox instance for '$dbname' (run 'ema sandbox srv/<name>-<GUID>' first)" >&2
            exit 1
        fi
        echo "$(_sandbox_ini "$key")"
    else
        echo "${REUTER_INI:-etc/reuter.ini}"
    fi
}

# Load the [<dbname>] section (the section header IS the database name).
_load_target() {
    local dbname="$1"
    if [[ -z "$dbname" ]]; then
        echo "Error: a database name is required (the section header is the database name)" >&2
        exit 1
    fi
    local reuter
    reuter="$(_reuter_file "$dbname")"
    if [[ ! -f "$reuter" ]]; then
        echo "Error: $reuter not found (sandbox: run 'ema sandbox ...'; prod: run gen-reuter)" >&2
        exit 1
    fi
    local vars
    vars=$(php -r "
        \$cnf = parse_ini_file('${reuter}', true);
        if (!\$cnf || !isset(\$cnf['${dbname}'])) {
            fwrite(STDERR, \"Error: section '${dbname}' not found in ${reuter}\n\");
            exit(1);
        }
        foreach (\$cnf['${dbname}'] as \$k => \$v)
            echo \$k . '=' . escapeshellarg(\$v) . PHP_EOL;
    ") || exit 1
    # The section is authoritative: clear any ambient connection vars first so
    # an exported value (e.g. MYSQL_UNIX_PORT from the dev shell) cannot leak
    # into a section that does not define it.
    unset SERVER PORT DBNAME DBMS ADMIN_PASSWORD READER_PASSWORD MYSQL_UNIX_PORT
    eval "$vars"
}

_mariadb_args() {
    if [[ -n "${MYSQL_UNIX_PORT:-}" ]]; then
        _MARIADB_ARGS=("--socket=$MYSQL_UNIX_PORT")
    else
        _MARIADB_ARGS=("-h" "$SERVER")
        [[ -n "${PORT:-}" ]] && _MARIADB_ARGS+=("-P" "$PORT")
    fi
}

# --- flag/option parsing (schematic-style, in bash) -------------------------
# _parse_flags <flags-spec> <options-spec> <args...>
#   flags-spec/options-spec: space-separated names (-f --force -q --quiet).
#   Bundled shorts (-nf) are split. Populates _POS_ARGS/_FLAGS/_OPTIONS.
_parse_flags() {
    local flags_spec="$1" options_spec="$2"
    shift 2
    _POS_ARGS=()
    _FLAGS=()
    _OPTIONS=()
    while [[ $# -gt 0 ]]; do
        local arg="$1"; shift
        if [[ "$arg" == "--" ]]; then
            _POS_ARGS+=("$@")
            break
        elif [[ "$arg" != -* ]]; then
            _POS_ARGS+=("$arg")
        elif _contains "$arg" $flags_spec; then
            _FLAGS+=("$arg")
        elif _contains "$arg" $options_spec; then
            if [[ $# -eq 0 ]]; then
                echo "Error: expected value for $arg" >&2
                exit 1
            fi
            _OPTIONS["$arg"]="$1"; shift
        elif [[ "$arg" =~ ^-[a-zA-Z0-9]{2,36}$ ]]; then
            # split up bundled short flags: -abc -> -a -b -c
            local i
            for (( i=1; i<${#arg}; i++ )); do
                set -- "-${arg:$i:1}" "$@"
            done
        else
            echo "Error: unexpected arg: $arg" >&2
            exit 1
        fi
    done
}

_contains() {
    local needle="$1"; shift
    local x
    for x in "$@"; do
        [[ "$x" == "$needle" ]] && return 0
    done
    return 1
}

_env_bool() {
    case "${1,,}" in
        1|yes|true|on) return 0 ;;
        *) return 1 ;;
    esac
}

# _get_flag <names...> — echo "yes"/"no". Short/long names check the parsed
# flags; bare names check the EMA_<NAME> env fallback (e.g. --force -> EMA_FORCE).
_get_flag() {
    local name
    for name in "$@"; do
        if [[ "$name" == -* ]]; then
            if _contains "$name" "${_FLAGS[@]}"; then echo "yes"; return; fi
        else
            local env_name="EMA_$(echo "$name" | tr '[:lower:]' '[:upper:]' | tr '-' '_')"
            if [[ -n "${!env_name:-}" ]] && _env_bool "${!env_name}"; then
                echo "yes"; return
            fi
        fi
    done
    echo "no"
}

# _get_option <name> [default] — parsed value first, then EMA_<NAME> fallback.
_get_option() {
    local name="$1" default="${2:-}"
    if [[ -n "${_OPTIONS[$name]+x}" ]]; then
        echo "${_OPTIONS[$name]}"
        return
    fi
    if [[ "$name" != -* ]]; then
        local env_name="EMA_$(echo "$name" | tr '[:lower:]' '[:upper:]' | tr '-' '_')"
        if [[ -n "${!env_name:-}" ]]; then
            echo "${!env_name}"
            return
        fi
    fi
    echo "$default"
}

# prompt_yesno <prompt> <default: yes|no> — schematic's prompt primitive.
# Reads a y/N or Y/n line; an empty/EOF answer falls back to the default.
prompt_yesno() {
    local prompt="$1" default="${2:-no}" answer
    local yes_default="no"
    case "${default,,}" in
        yes|y) yes_default="yes" ;;
    esac
    if [[ "$yes_default" == "yes" ]]; then
        read -r -p "$prompt (Y/n) " answer || true
    else
        read -r -p "$prompt (y/N) " answer || true
    fi
    case "${answer,,}" in
        y|yes) return 0 ;;
        n|no) return 1 ;;
        *) [[ "$yes_default" == "yes" ]] ;;
    esac
}

_is_help() {
    case "${1:-}" in
        help|-h|--help|-H|-help) return 0 ;;
        *) return 1 ;;
    esac
}

# --- per-instance sandbox server helpers (var/sandbox/<name>-<guid>) ---------
_sandbox_pid_value() {
    local pidfile
    pidfile="$(_sandbox_pid "$1")"
    if [[ -f "$pidfile" ]]; then
        cat "$pidfile"
    fi
}

_sandbox_up() {
    local pid
    pid="$(_sandbox_pid_value "$1")"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

_assert_sandbox_lifecycle() {
    if ! _is_sandbox; then
        echo "Error: server lifecycle commands manage sandbox instances (var/sandbox) only" >&2
        exit 1
    fi
}

_sandbox_start() {
    local key="$1" quiet="$2"
    if _sandbox_up "$key"; then
        [[ "$quiet" == "yes" ]] || echo "already running (pid $(_sandbox_pid_value "$key"))"
        return
    fi
    if [[ ! -d "$(_sandbox_data "$key")" ]]; then
        echo "Error: no data dir for sandbox '$key' — build it first ('ema sandbox ...')" >&2
        exit 1
    fi
    mkdir -p var/log
    # mysqld resolves RELATIVE --datadir/--pid-file/--socket against its own
    # basedir (e.g. the nix store prefix), not the CWD — absolutize like
    # bin/dev/init-cluster.sh does (mariadb-install-db has the same quirk).
    local datadir="$PWD/$(_sandbox_data "$key")"
    local pidfile="$PWD/$(_sandbox_pid "$key")"
    local sockfile="$PWD/$(_sandbox_sock "$key")"
    mysqld --datadir="$datadir" \
           --pid-file="$pidfile" \
           --socket="$sockfile" \
           --skip-networking >> var/log/mariadb.log 2>&1 &
    local i pid=""
    for (( i=0; i<50; i++ )); do
        pid="$(_sandbox_pid_value "$key")"
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            break
        fi
        sleep 0.1
    done
    if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
        echo "Error: MariaDB server failed to start for '$key' (see var/log/mariadb.log)" >&2
        exit 1
    fi
    [[ "$quiet" == "yes" ]] || echo "started (pid $pid)"
}

_sandbox_stop() {
    local key="$1" quiet="$2"
    local pid
    pid="$(_sandbox_pid_value "$key")"
    if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
        [[ "$quiet" == "yes" ]] || echo "not running"
        return
    fi
    # Graceful shutdown via mariadb-admin over the sandbox socket; fall back to
    # SIGTERM on the pid, then SIGKILL if it does not exit.
    if ! mariadb-admin -u root --socket="$(_sandbox_sock "$key")" shutdown >/dev/null 2>&1; then
        kill "$pid" 2>/dev/null || true
    fi
    local i
    for (( i=0; i<100; i++ )); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
        echo "Error: server did not stop gracefully — sending SIGKILL" >&2
        kill -9 "$pid" 2>/dev/null || true
        sleep 0.2
    fi
    [[ "$quiet" == "yes" ]] || echo "stopped"
}

_age() {
    local path="$1" now mtime diff
    if [[ ! -e "$path" ]]; then
        echo "-"
        return
    fi
    now=$(date +%s)
    mtime=$(stat -c %Y "$path")
    diff=$(( now - mtime ))
    if (( diff < 60 )); then
        echo "${diff}s"
    elif (( diff < 3600 )); then
        echo "$(( diff / 60 ))m"
    elif (( diff < 86400 )); then
        echo "$(( diff / 3600 ))h"
    else
        echo "$(( diff / 86400 ))d"
    fi
}

# --- commands ----------------------------------------------------------------

_help_schema() {
    cat <<'HELP'
Usage: ema schema <name>

Create a new schema package pkg/<name>-<GUID>/ with default.php and upgrade.sql.
HELP
}

_cmd_schema() {
    if _is_help "$@"; then
        _help_schema
        return
    fi
    if [[ -z "$1" ]]; then
        echo "Error: must provide a name for the schema" >&2
        _help_schema
        exit 1
    fi
    _assert_repo_root
    local prefix="$1"
    if ls -d "pkg/${prefix}"-* 1>/dev/null 2>&1; then
        echo "Error: Schema with prefix '$prefix' already exists in pkg/." >&2
        return 1
    fi
    local guid
    guid=$(_gen_guid S0)
    local directory_name="${prefix}-${guid}"
    mkdir -p "pkg/${directory_name}"
    touch "pkg/${directory_name}/upgrade.sql"
    cat <<EOD > "pkg/${directory_name}/default.php"
<?php
\$dependencies = array();
?>
EOD
    echo "Directory created: pkg/${directory_name}"
}

_help_mariadb() {
    cat <<'HELP'
Usage: ema mariadb <db> [args...]

Open a MariaDB shell against a database's section. Extra args are passed
through to the client (e.g. ema mariadb test -e "SHOW TABLES;"). Raw SQL
from a file uses stdin redirection: ema mariadb <db> < file.sql
HELP
}

_cmd_mariadb() {
    if _is_help "$@"; then
        _help_mariadb
        return
    fi
    _assert_repo_root
    local dbname="" _args=("$@")
    if [ "${#_args[@]}" -gt 0 ] && [[ "${_args[0]}" != -* ]]; then
        dbname="${_args[0]}"
    fi
    _load_target "$dbname"
    _mariadb_args
    local _db_user
    if _is_sandbox; then
        _db_user="root"
    else
        _db_user="${DBUSER:-$USER}"
    fi
    exec "$DBMS" -u "$_db_user" "${_MARIADB_ARGS[@]}" "${_args[@]}"
}

_gen_password() {
    tr -dc 'A-Za-z0-9' < /dev/urandom | fold -w 24 | head -n 1
}

# <prefix> + 14 random base36 chars -- schematic's type-prefixed GUID
# convention (16 chars total). The prefix maps a package to its kind: S0 for
# schema packages (pkg/), D0 for database packages (srv/).
_gen_guid() {
    local prefix="$1"
    local suffix
    suffix=$(tr -dc 'A-Z0-9' < /dev/urandom | fold -w 14 | head -n 1)
    printf '%s%s\n' "$prefix" "$suffix"
}

# Load srv/<name>-<GUID>/default.php and print its definition as JSON
# ({"dir":..., "db":{...}|null, "dependencies":[...]}).
_srv_definition() {
    php -r "
        require '${_EMA_LIB}/sort_schemas.php';
        echo json_encode(srv_definition('$1'));
    "
}

# Write the per-instance var/sandbox/<key>/reuter.ini with a [<dbname>]
# section. Written only on first build; reapply reuses the file so the
# instance-generated secrets stay stable across re-runs.
_write_sandbox_ini() {
    local key="$1" dbname="$2" admin_pw="$3" reader_pw="$4"
    local ini
    ini="$(_sandbox_ini "$key")"
    mkdir -p "$(dirname "$ini")"
    cat > "$ini" <<EOF
; Generated by ema sandbox — machine-local (git-ignored).
; One [<dbname>] section per sandbox instance; the header IS the database name.
[$dbname]
SERVER=localhost
PORT=0
DBMS=mariadb
DBNAME=$dbname
MYSQL_UNIX_PORT=$(_sandbox_sock "$key")
ADMIN_PASSWORD=$admin_pw
READER_PASSWORD=$reader_pw
EOF
}

# Run a SQL file as root against the resolved connection (after _load_target +
# _mariadb_args). <dbname> may be empty (bootstrap SQL creates/uses its own
# database via {{dbname}}). Falls back to sudo for system installs where the
# root socket requires elevation; the sandbox itself stays user-owned.
_run_root_sql() {
    local dbname="$1" sqlfile="$2"
    local args=(-u root "${_MARIADB_ARGS[@]}")
    if [[ -n "$dbname" ]]; then
        args+=("$dbname")
    fi
    if ! "$DBMS" "${args[@]}" < "$sqlfile" 2>/dev/null; then
        sudo env PATH="$PATH" MYSQL_UNIX_PORT="$MYSQL_UNIX_PORT" "$DBMS" "${args[@]}" < "$sqlfile"
    fi
}

# Shared streaming primitive: topo-sort the package graph rooted at
# root_pkgs..., concatenate each package's upgrade.sql, wrap it in FK guards,
# and fill {{dbname}}/{{servername}} — writing the result to <outfile>.
_build_schema_sql() {
    local dbname="$1" outfile="$2"
    shift 2
    local root_pkgs=("$@") roots_json="" r
    for r in "${root_pkgs[@]}"; do
        [[ -n "$roots_json" ]] && roots_json+=","
        roots_json+="\"$r\""
    done
    roots_json="[$roots_json]"
    local schemas_json
    schemas_json=$(php -r "
        require '${_EMA_LIB}/sort_schemas.php';
        \$graph = build_dependency_graph_roots(json_decode('${roots_json}', true));
        echo json_encode(\$graph->topological_sort());
    ") || exit 1
    local schemas_array
    mapfile -t schemas_array < <(echo "$schemas_json" | jq -r '.[]')
    local workdir pseudo_sql schema schema_dir
    workdir=$(mktemp -d /tmp/table_schemas_XXXXXX)
    pseudo_sql="${workdir}/pseudo_query.sql"
    for schema in "${schemas_array[@]}"; do
        schema_dir="$(_find_package "$schema")" || {
            echo "Error: schema package '$schema' not found" >&2
            rm -r "$workdir"
            return 1
        }
        if [[ -f "$schema_dir/upgrade.sql" ]]; then
            cat "$schema_dir/upgrade.sql" >> "$pseudo_sql"
            echo "" >> "$pseudo_sql"
        fi
    done
    { echo "SET FOREIGN_KEY_CHECKS=0;"; \
      sed "s/{{dbname}}/${dbname}/g; s/{{servername}}/${SERVER}/g;" "$pseudo_sql"; \
      echo "SET FOREIGN_KEY_CHECKS=1;"; } > "$outfile"
    rm -r "$workdir"
}

# Apply the dependency graph of root_pkgs... to <dbname> (non-destructive:
# CREATE OR REPLACE, no DROP).
_apply_pkg_graph() {
    local dbname="$1"
    shift
    local root_pkgs=("$@") workdir sql
    workdir=$(mktemp -d /tmp/ema_schema_XXXXXX)
    sql="${workdir}/query.sql"
    _build_schema_sql "$dbname" "$sql" "${root_pkgs[@]}" || { rm -r "$workdir"; exit 1; }
    _run_root_sql "$dbname" "$sql"
    rm -r "$workdir"
}

# Build the srv bootstrap SQL into <outfile>: read srv/<name>-<GUID>/upgrade.sql
# and fill {{dbname}}/{{charset}}/{{collation}}/{{servername}} from default.php
# defaults plus {{admin_password}}/{{reader_password}} from instance-generated
# secrets.
_build_srv_bootstrap_sql() {
    local srv_dir="$1" outfile="$2" admin_pw="$3" reader_pw="$4"
    local defs dbname charset collation servername
    defs=$(php -r "
        require '${srv_dir}/default.php';
        echo json_encode(array(
            'dbname' => \$db['dbname'] ?? '',
            'charset' => \$db['charset'] ?? 'utf8',
            'collation' => \$db['collation'] ?? 'utf8_spanish_ci',
            'servername' => \$db['servername'] ?? 'localhost',
        ));
    ") || exit 1
    dbname=$(echo "$defs" | jq -r '.dbname')
    charset=$(echo "$defs" | jq -r '.charset')
    collation=$(echo "$defs" | jq -r '.collation')
    servername=$(echo "$defs" | jq -r '.servername')
    sed "s/{{dbname}}/${dbname}/g; s/{{charset}}/${charset}/g; s/{{collation}}/${collation}/g; s/{{servername}}/${servername}/g; s/{{admin_password}}/${admin_pw}/g; s/{{reader_password}}/${reader_pw}/g;" \
        "${srv_dir}/upgrade.sql" > "$outfile"
}

# Synthesize the bootstrap SQL for a pkg/ sandbox (no srv package): a default
# database + admin/reader users + grants, filled from synthesized defaults and
# instance-generated secrets.
_build_synth_bootstrap_sql() {
    local dbname="$1" charset="$2" collation="$3" servername="$4" admin_pw="$5" reader_pw="$6" outfile="$7"
    cat > "$outfile" <<EOF
SET check_constraint_checks = OFF;
DROP DATABASE IF EXISTS ${dbname};
CREATE OR REPLACE DATABASE ${dbname}
COMMENT 'ema ${dbname} database'
CHARACTER SET = '${charset}'
COLLATE = '${collation}';
DROP USER IF EXISTS 'admin'@'${servername}';
CREATE USER 'admin'@'${servername}' IDENTIFIED BY '${admin_pw}';
DROP USER IF EXISTS 'reader'@'${servername}';
CREATE USER 'reader'@'${servername}' IDENTIFIED BY '${reader_pw}';
GRANT SELECT ON ${dbname}.* TO 'reader'@'${servername}';
GRANT SELECT, INSERT, UPDATE, DELETE ON ${dbname}.* TO 'admin'@'${servername}';
EOF
}

# After a successful init, open the shell (ema mariadb <db>) unless
# -n/--no-shell, in which case print the command instead. When stdin is not a
# terminal (pipes, CI), print the command too so scripts never block.
_maybe_open_shell() {
    local dbname="$1" no_shell
    no_shell=$(_get_flag --no-shell -n no_shell)
    if [[ "$no_shell" == "yes" ]]; then
        echo "Run: ema mariadb $dbname"
    elif [[ -t 0 ]]; then
        echo "Opening shell for $dbname (use -n/--no-shell to skip)..."
        _cmd_mariadb "$dbname"
    else
        echo "Run: ema mariadb $dbname"
    fi
}

_help_sandbox() {
    cat <<'HELP'
Usage: ema sandbox <target> [flags]

Build (or reapply) a per-instance sandbox for a database or schema package.
Each sandbox owns its MariaDB instance (datadir/socket/pid under
var/sandbox/<name>-<guid>/).

Targets:
  srv/<name>-<GUID>   Build instance + bootstrap (create db/users/grants) +
                      apply the schema-package deps in topological order.
  pkg/<pkg>-<GUID>    Synthesize a default database (zero deps) and apply the
                      pkg's dependency graph.

First build runs the destructive bootstrap (create instance + database +
users + grants). Re-running against an existing instance is non-destructive:
bootstrap is skipped and the dependency graph is reapplied (never DROP).

Flags:
  -n, --no-shell      Print 'ema mariadb <db>' instead of opening the shell
  -q, --quiet         Suppress non-error output
HELP
}

_cmd_sandbox() {
    if _is_help "$@"; then
        _help_sandbox
        return
    fi
    _parse_flags "-n --no-shell -q --quiet -v --verbose" "" "$@"
    local target="${_POS_ARGS[0]:-}"
    if [[ -z "$target" ]]; then
        echo "Error: must provide a target (e.g., ema sandbox srv/test-D01B9X95PUIWQ60Q)" >&2
        _help_sandbox
        exit 1
    fi
    _assert_repo_root
    if [[ "$target" == srv/* ]]; then
        _sandbox_srv "$target"
    elif [[ "$target" == pkg/* ]]; then
        _sandbox_pkg "$target"
    else
        echo "Error: target must be srv/<name>-<GUID> or pkg/<pkg>-<GUID> (got '$target')" >&2
        _help_sandbox
        exit 1
    fi
}

# Build/reapply a sandbox for an srv/<name>-<GUID> database package.
_sandbox_srv() {
    local target="$1" ref defs dbname srv_dir deps_json key
    ref="${target#srv/}"
    defs="$(_srv_definition "$ref")" || exit 1
    dbname=$(echo "$defs" | jq -r '.db.dbname')
    if [[ -z "$dbname" || "$dbname" == "null" ]]; then
        echo "Error: srv/$ref/default.php has no \$db definition (dbname required)" >&2
        exit 1
    fi
    srv_dir=$(echo "$defs" | jq -r '.dir')
    deps_json=$(echo "$defs" | jq -c '.dependencies')
    key="$(_instance_key "$target")"
    local deps=()
    mapfile -t deps < <(echo "$deps_json" | jq -r '.[]')
    _sandbox_build "$key" "$dbname" "$srv_dir" "${deps[@]}"
}

# Build/reapply a sandbox for a pkg/<pkg>-<GUID> schema package.
_sandbox_pkg() {
    local target="$1" key dbname
    key="$(_instance_key "$target")"
    dbname="$(_instance_name "$key")"
    _sandbox_build "$key" "$dbname" "" "$key"
}

# Shared sandbox build/reapply driver. <srv_dir> is the srv/ package dir for a
# database sandbox (bootstrap read from its upgrade.sql), or "" to synthesize a
# default bootstrap. <deps> are the schema-package graph roots.
_sandbox_build() {
    local key="$1" dbname="$2" srv_dir="$3"
    shift 3
    local deps=("$@")
    local datadir admin_pw reader_pw workdir sql first="no"
    datadir="$(_sandbox_data "$key")"
    if [[ ! -d "$datadir" ]]; then
        first="yes"
    fi
    if [[ "$first" == "yes" ]]; then
        admin_pw="$(_gen_password)"
        reader_pw="$(_gen_password)"
        mkdir -p "$(_sandbox_dir "$key")"
        _write_sandbox_ini "$key" "$dbname" "$admin_pw" "$reader_pw"
        mkdir -p "$datadir"
        if ! mariadb-install-db --auth-root-authentication-method=normal --skip-test-db \
                --datadir="$PWD/$datadir" --pid-file="$PWD/$(_sandbox_pid "$key")" >/dev/null 2>&1; then
            echo "Error: mariadb-install-db failed for '$key'" >&2
            exit 1
        fi
    fi
    _sandbox_start "$key" "yes" || exit 1
    _load_target "$dbname"
    _mariadb_args
    if [[ "$first" == "yes" ]]; then
        workdir=$(mktemp -d /tmp/ema_bootstrap_XXXXXX)
        sql="${workdir}/bootstrap.sql"
        if [[ -n "$srv_dir" ]]; then
            _build_srv_bootstrap_sql "$srv_dir" "$sql" "$admin_pw" "$reader_pw"
        else
            _build_synth_bootstrap_sql "$dbname" "utf8" "utf8_spanish_ci" "localhost" "$admin_pw" "$reader_pw" "$sql"
        fi
        _run_root_sql "" "$sql"
        rm -r "$workdir"
    fi
    if [[ "${#deps[@]}" -gt 0 ]]; then
        _apply_pkg_graph "$dbname" "${deps[@]}"
    fi
    _maybe_open_shell "$dbname"
}

_help_drop() {
    cat <<'HELP'
Usage: ema drop <db> [flags]

Delete a database. In sandbox mode the deletion unit is the instance: the
whole var/sandbox/<name>-<guid>/ directory (datadir/socket/pid/reuter.ini) is
removed after stopping its server. In prod mode the database is dropped with
DROP DATABASE over the resolved section.

Destruction safety ladder:
  sandbox          prompts "remove sandbox database …? (Y/n)" (default Yes)
  prod             refuses without --force
  prod + --force   prompts "remove database …? (y/N)" (default No)

Flags:
  -f, --force       Insist on dropping a non-sandbox (prod) database
  -q, --quiet       Suppress success output
  -v, --verbose     Print the action to stderr

Examples:
  ema drop test
  ema drop mydb --force
HELP
}

_cmd_drop() {
    if _is_help "$@"; then
        _help_drop
        return
    fi
    _parse_flags "-f --force -q --quiet -v --verbose" "" "$@"
    local ref="${_POS_ARGS[0]:-}"
    if [[ -z "$ref" ]]; then
        echo "Error: must provide a database name (e.g., ema drop mydb)" >&2
        _help_drop
        exit 1
    fi
    _assert_repo_root
    local force quiet verbose
    force=$(_get_flag --force -f force)
    quiet=$(_get_flag --quiet -q quiet)
    verbose=$(_get_flag --verbose -v verbose)
    if _is_sandbox; then
        local key dbname
        key="$(_resolve_instance "$ref")" || exit 1
        if [[ -z "$key" ]]; then
            echo "Error: no sandbox instance for '$ref'" >&2
            exit 1
        fi
        dbname="$(_instance_name "$key")"
        if ! prompt_yesno "remove sandbox database $dbname?" "yes"; then
            echo "aborted." >&2
            exit 1
        fi
        [[ "$verbose" == "yes" ]] && echo "Removing sandbox instance: var/sandbox/$key" >&2
        _sandbox_stop "$key" "yes"
        rm -rf "var/sandbox/$key"
        [[ "$quiet" == "no" ]] && echo "Removed sandbox: $dbname ($key)"
        return
    fi
    # prod: DROP DATABASE over the resolved section, guarded by --force.
    local dbname="$ref"
    if [[ "$force" == "no" ]]; then
        echo "Error: not a sandbox database: $dbname (hint: use 'ema drop --force' to insist on deleting)" >&2
        exit 1
    fi
    if ! prompt_yesno "remove database $dbname?" "no"; then
        echo "aborted." >&2
        exit 1
    fi
    _load_target "$dbname"
    _mariadb_args
    local drop_sql
    drop_sql="DROP DATABASE IF EXISTS \`$dbname\`;"
    [[ "$verbose" == "yes" ]] && echo "Running: $DBMS -u root ${_MARIADB_ARGS[*]} -e \"$drop_sql\"" >&2
    "$DBMS" -u root "${_MARIADB_ARGS[@]}" -e "$drop_sql" 2>/dev/null || \
        sudo env PATH="$PATH" MYSQL_UNIX_PORT="${MYSQL_UNIX_PORT:-}" "$DBMS" -u root "${_MARIADB_ARGS[@]}" -e "$drop_sql"
    [[ "$quiet" == "no" ]] && echo "Dropped database: $dbname"
}

_help_gc() {
    cat <<'HELP'
Usage: ema gc [flags]

Remove stopped sandbox instances under var/sandbox/ (sandbox mode only).

Every var/sandbox/<name>-<guid>/ whose server is not running is removed in
whole (datadir/socket/pid/reuter.ini). Running instances are left alone.

Flags:
  -q, --quiet       Suppress output
HELP
}

_cmd_gc() {
    if _is_help "$@"; then
        _help_gc
        return
    fi
    _parse_flags "-q --quiet -v --verbose" "" "$@"
    local quiet verbose
    quiet=$(_get_flag --quiet -q quiet)
    verbose=$(_get_flag --verbose -v verbose)
    _assert_repo_root
    if ! _is_sandbox; then
        echo "Error: gc operates on sandbox instances (var/sandbox) only" >&2
        exit 1
    fi
    if [[ ! -d "var/sandbox" ]]; then
        [[ "$quiet" == "no" ]] && echo "Nothing to gc."
        return
    fi
    local dirs key found="no" keys=()
    mapfile -t keys < <(ls -d var/sandbox/*/ 2>/dev/null)
    for dirs in "${keys[@]}"; do
        key=$(basename "$dirs")
        if _sandbox_up "$key"; then
            [[ "$verbose" == "yes" ]] && echo "gc: skipping running instance '$key'" >&2
            continue
        fi
        found="yes"
        rm -rf "var/sandbox/$key"
        [[ "$quiet" == "no" ]] && echo "gc: removed var/sandbox/$key"
    done
    if [[ "$found" == "no" && "$quiet" == "no" ]]; then
        echo "Nothing to gc."
    fi
}

_help_status() {
    cat <<'HELP'
Usage: ema status [flags]

List sandbox instances (sandbox mode) or the prod reuter file's sections
(prod mode) with state:
  sandbox: each var/sandbox/<name>-<guid>/ instance, its server up/down,
           socket endpoint, and the age of its reuter.ini
  prod:    per-section reachability (TCP port, or the socket file for
           sections that define MYSQL_UNIX_PORT)

Flags:
  -v, --verbose     Verbose output to stderr
HELP
}

_cmd_status() {
    if _is_help "$@"; then
        _help_status
        return
    fi
    _parse_flags "-q --quiet -v --verbose" "" "$@"
    local quiet verbose
    quiet=$(_get_flag --quiet -q quiet)
    verbose=$(_get_flag --verbose -v verbose)
    _assert_repo_root
    if _is_sandbox; then
        _status_sandbox
    else
        _status_prod
    fi
}

_status_sandbox() {
    if [[ ! -d "var/sandbox" ]]; then
        echo "No sandbox instances."
        return
    fi
    local keys=() dirs key
    mapfile -t keys < <(ls -d var/sandbox/*/ 2>/dev/null)
    if [[ ${#keys[@]} -eq 0 ]]; then
        echo "No sandbox instances."
        return
    fi
    for dirs in "${keys[@]}"; do
        key=$(basename "$dirs")
        local pid state endpoint age ini
        ini="$(_sandbox_ini "$key")"
        pid="$(_sandbox_pid_value "$key")"
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            state="up"
        else
            state="dn"
        fi
        endpoint="socket $(_sandbox_sock "$key")"
        age="$(_age "$ini")"
        printf '[%s]  %-2s  %-30s  %-6s  %s\n' "$key" "$state" "$endpoint" "$age" "$ini"
    done
}

_status_prod() {
    local reuter
    reuter="$(_reuter_file)"
    if [[ ! -f "$reuter" ]]; then
        echo "Error: $reuter not found" >&2
        exit 1
    fi
    local names
    names=$(php -r "
        \$cnf = parse_ini_file('${reuter}', true);
        if (!\$cnf) exit(0);
        foreach (array_keys(\$cnf) as \$k) echo \$k, PHP_EOL;
    ") || exit 1
    if [[ -z "$names" ]]; then
        echo "No sections in $reuter."
        return
    fi
    local name
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        local vars endpoint state
        vars=$(php -r "
            \$cnf = parse_ini_file('${reuter}', true);
            foreach (['SERVER','PORT','MYSQL_UNIX_PORT'] as \$k)
                if (isset(\$cnf['${name}'][\$k])) echo \$k, '=', escapeshellarg(\$cnf['${name}'][\$k]), PHP_EOL;
        ")
        eval "$vars"
        if [[ -n "${MYSQL_UNIX_PORT:-}" ]]; then
            endpoint="socket $MYSQL_UNIX_PORT"
            if [[ -S "$MYSQL_UNIX_PORT" ]]; then state="up"; else state="dn"; fi
        else
            endpoint="${SERVER:-?}:${PORT:-?}"
            if timeout 2 bash -c "</dev/tcp/$SERVER/$PORT" 2>/dev/null; then state="up"; else state="dn"; fi
        fi
        printf '[%s]  %-2s  %-30s  %-6s  %s\n' "$name" "$state" "$endpoint" "-" "$reuter"
        unset SERVER PORT MYSQL_UNIX_PORT
    done <<< "$names"
}

_list_sandbox_keys() {
    if [[ -d "var/sandbox" ]]; then
        local d
        for d in var/sandbox/*/; do
            [[ -d "$d" ]] && basename "$d"
        done
    fi
}

# Resolve the instance keys a lifecycle command operates on: one key when a ref
# is given, otherwise every sandbox instance.
_lifecycle_keys() {
    local ref="$1" k
    if [[ -n "$ref" ]]; then
        k="$(_resolve_instance "$ref")" || return 1
        if [[ -z "$k" ]]; then
            echo "Error: no sandbox instance for '$ref'" >&2
            return 1
        fi
        echo "$k"
    else
        _list_sandbox_keys
    fi
}

