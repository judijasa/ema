_help_deps() {
    cat <<'HELP'
Usage: ema deps <root-pkg>

Print the schema packages under <root-pkg> in topological order, one per line
(the apply order used by 'ema sandbox pkg/<root-pkg>').
HELP
}

_cmd_deps() {
    if _is_help "$@"; then
        _help_deps
        return
    fi
    local root_pkg="${1:-}"
    if [[ -z "$root_pkg" ]]; then
        echo "Error: must provide a root package (e.g., ema deps mypkg-HASH)" >&2
