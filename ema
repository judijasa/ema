#!/bin/bash

# Resolve the real location of this script so _EMA_LIB self-locates whether
# run in-tree, or via the Composer `vendor/bin/ema` symlink. EMA_LIB (env)
# still wins when set.
_EMA_SELF="$(readlink -f "${BASH_SOURCE[0]}")"
_EMA_LIB="${EMA_LIB:-$(cd "$(dirname "${_EMA_SELF}")" && pwd)/src}"

PROGRAM_NAME="ema"

# Parse state, populated by _parse_flags (one command invocation at a time).
declare -a _POS_ARGS=()
declare -a _FLAGS=()
declare -A _OPTIONS=()

show_help() {
    cat <<HELP
Usage: $PROGRAM_NAME <command> [arguments]

Database lifecycle & shell:
  create srv/<name>-<GUID>    Provision the DB instance + create a prod database
  values <db>                 Print a prod database's instance connectivity (recovery)
  sandbox srv/<name>-<GUID>   Build a disposable per-instance sandbox (create-only)
  sandbox pkg/<pkg>-<GUID>    Build a disposable sandbox for a schema package
  mariadb <db> [args...]      Open a MariaDB shell against a database's section
  start [<path>]              Start sandbox instance(s) (var/sandbox)
  stop [<path>]               Stop sandbox instance(s)
  restart [<path>]            Restart sandbox instance(s)
  status                      List sandbox instances + prod sections with state
  gc [<path>]                 Remove stopped sandbox instances under var/sandbox

Schema packages:
  schema <name>               Create a new schema package in pkg/
  database <name>             Create srv/<name>-<GUID>/ package (default definition)
  inspect <root-pkg>          Show the schema dependency graph
  deps <root-pkg>             List schema packages in topological order

Options:
  -h, --help             Show this help message and exit
  -v, --version          Show program version

Run '$PROGRAM_NAME <command> --help' for per-command help.

Environment:
  EMA_TARGET             sandbox or prod (default) — connection flag for the
                         dbname-addressed verb (mariadb)
  REUTER_INI             Prod reuter.ini path (used when EMA_TARGET=prod)
  DBUSER                 CLI client user for a prod TCP connection (default: \$USER);
                         required when the instance is not on this host
  DBPASS                 Password for DBUSER, forwarded to the client as
                         MYSQL_PWD; unset leaves the password to the client's
                         own sources (MYSQL_PWD, ~/.my.cnf)
  EMA_PROD_BASE          Prod instance base dir (default: /var/lib/mariadb)
  EMA_PROD_USER          System user the prod instance runs as (default: mysql)
  EMA_PROD_BIND          Prod instance bind address (default: 0.0.0.0)
  EMA_SERVER             SERVER value emitted for prod sections (default: host overlay IP)
  EMA_FORCE/EMA_QUIET/EMA_VERBOSE/EMA_NO_SHELL
                         Env fallbacks for the -f/-q/-v/-n flags
HELP
}

show_version() {
    echo "$PROGRAM_NAME version 1.0.0"
}

_assert_repo_root() {
    if [[ ! -d "pkg" ]]; then
        echo "Error: pkg/ not found — run ema from your project root" >&2
        exit 1
    fi
}

# Resolve a schema package dir via sort_schemas.php's find_package().
# Prints the absolute dir on success (return 0); prints nothing and returns 1
# when the package is absent from every root (local pkg/ or an installed
# Composer provider's pkg/).
_find_package() {
    local schema="$1"
    php -r "
        require '${_EMA_LIB}/sort_schemas.php';
        \$dir = find_package('${schema}');
        if (\$dir !== null) { echo \$dir; exit(0); }
        exit(1);
    "
}

# --- target & connection resolution -----------------------------------------
# EMA_TARGET is a binary sandbox/prod flag telling ema whether the
# dbname-addressed verb (mariadb) resolves a sandbox connection — the
# per-instance var/sandbox/<name>-<guid>/reuter.ini — or a prod one:
# REUTER_INI, fallback etc/reuter.ini. Everything else resolves its own target:
# 'sandbox' (build + lifecycle), 'create'/'values' and the path-addressed
# lifecycle verbs never consult it, and 'status' lists both sides.
# Unset/empty means prod — the app layer's convention, so EMA_TARGET is one
# switch across the CLI and the app; sandbox is explicit.
#
# On the prod side the section decides the transport: its socket, as root, when
# the instance exists on this host; its SERVER/PORT over TCP as DBUSER when it
# does not (see doc/system/mariadb-remote.md).
_target() {
    case "${EMA_TARGET:-}" in
        sandbox) echo "sandbox" ;;
        ""|prod) echo "prod" ;;
        *) echo "Error: EMA_TARGET must be 'sandbox' or 'prod' (got '${EMA_TARGET}')" >&2; exit 1 ;;
    esac
}

_is_sandbox() { [[ "$(_target)" == "sandbox" ]]; }

# Normalize a target ref (<name>-<GUID>, or an srv/... or pkg/... path) to the
# bare instance key <name>-<GUID>.
_instance_key() {
    local ref="${1:-}"
    echo "${ref##*/}"
}

# Split <name>-<GUID> into <name>. GUIDs are 16 chars (2-char type prefix +
# 14 base36), so the name is everything before the trailing '-<16 chars>'.
_instance_name() {
    local key="${1:-}"
    echo "${key%-${key: -16}}"
}

# Per-instance sandbox paths (var/sandbox/<name>-<guid>/).
_sandbox_dir()  { echo "var/sandbox/$1"; }
_sandbox_data() { echo "var/sandbox/$1/data"; }
_sandbox_pid()  { echo "var/sandbox/$1/mysql.pid"; }
_sandbox_sock() { echo "var/sandbox/$1/mysql.sock"; }
_sandbox_ini()  { echo "var/sandbox/$1/reuter.ini"; }

# Resolve a name-addressed ref (a bare dbname, or a full <name>-<GUID>) to its
# sandbox instance key. This is the dbname-addressed path (_reuter_file, for
# 'ema mariadb <db>'); the lifecycle verbs address an instance by path instead,
# via _resolve_instance_path.
# Prints the key; returns 1 when no instance exists; errors on ambiguity.
_resolve_instance() {
    local ref="${1:-}" key dirs
    key="$(_instance_key "$ref")"
    if [[ -d "var/sandbox/$key" ]]; then
        echo "$key"
        return 0
    fi
    mapfile -t dirs < <(ls -d "var/sandbox/${key}"-*/ 2>/dev/null)
    if [[ ${#dirs[@]} -eq 1 ]]; then
        basename "${dirs[0]}"
        return 0
    fi
    if [[ ${#dirs[@]} -gt 1 ]]; then
        echo "Error: multiple sandboxes match '$ref' (use a full <name>-<GUID>)" >&2
        return 1
    fi
    return 1
}

# Resolve a path-addressed ref to its sandbox instance key. Lifecycle verbs
# address an instance by the directory that holds it (var/sandbox/<name>-<guid>,
# as printed by 'ema status'), so the side falls out of the path and the address
# is never ambiguous. Prints the key; returns 1 with a hint otherwise.
_resolve_instance_path() {
    local ref="${1:-}" key
    ref="${ref%/}"
    case "$ref" in
        var/sandbox/*|*/var/sandbox/*) ;;
        *)
            echo "Error: not a sandbox instance path: $ref" >&2
            echo "  Instances are addressed by path — copy one from 'ema status'." >&2
            return 1
            ;;
    esac
    key="${ref##*/}"
    if [[ ! -d "var/sandbox/$key" ]]; then
        echo "Error: no such sandbox instance: $ref" >&2
        return 1
    fi
    echo "$key"
}

# The prod connection file: $REUTER_INI, fallback etc/reuter.ini. Resolved
# directly by the verbs that are inherently prod (create/values).
_prod_reuter_file() { echo "${REUTER_INI:-etc/reuter.ini}"; }

# The connection file for a database under flag-driven resolution:
#   sandbox -> the per-instance var/sandbox/<name>-<guid>/reuter.ini
#   prod    -> $REUTER_INI (fallback etc/reuter.ini)
# Only the dbname-addressed verb (mariadb) uses this; every other verb
# resolves its file directly.
_reuter_file() {
    local dbname="${1:-}"
    if _is_sandbox; then
        local key
        key="$(_resolve_instance "$dbname")" || exit 1
        if [[ -z "$key" ]]; then
            echo "Error: no sandbox instance for '$dbname' (run 'ema sandbox srv/<name>-<GUID>' first)" >&2
            exit 1
        fi
        echo "$(_sandbox_ini "$key")"
    else
        echo "${REUTER_INI:-etc/reuter.ini}"
    fi
}

# Load the [<dbname>] section of <reuter> (the section header IS the database
# name) into the connection vars (SERVER/PORT/MYSQL_UNIX_PORT). The caller picks
# the file: _prod_reuter_file / _sandbox_ini for the one-sided verbs, the
# flag-driven _reuter_file for the dbname-addressed verb (mariadb).
_load_section() {
    local reuter="$1" dbname="$2"
    if [[ -z "$dbname" ]]; then
        echo "Error: a database name is required (the section header is the database name)" >&2
        exit 1
    fi
    if [[ ! -f "$reuter" ]]; then
        echo "Error: $reuter not found (sandbox: run 'ema sandbox ...'; prod: record the section from 'ema values <db>')" >&2
        exit 1
    fi
    local vars
    vars=$(php -r "
        \$cnf = parse_ini_file('${reuter}', true);
        if (!\$cnf || !isset(\$cnf['${dbname}'])) {
            fwrite(STDERR, \"Error: section '${dbname}' not found in ${reuter}\n\");
            exit(1);
        }
        foreach (\$cnf['${dbname}'] as \$k => \$v)
            echo \$k . '=' . escapeshellarg(\$v) . PHP_EOL;
    ") || exit 1
    # The section is authoritative: clear any ambient connection vars first so
    # an exported value (e.g. MYSQL_UNIX_PORT from the dev shell) cannot leak
    # into a section that does not define it.
    unset SERVER PORT DBNAME MYSQL_UNIX_PORT
    eval "$vars"
}

# Flag-driven load: pick the connection file for <dbname> (the sandbox
# instance's ini vs the prod file), then load its section.
_load_target() {
    local dbname="$1" reuter
    reuter="$(_reuter_file "$dbname")" || exit 1
    _load_section "$reuter" "$dbname"
}

_mariadb_args() {
    if [[ -n "${MYSQL_UNIX_PORT:-}" ]]; then
        _MARIADB_ARGS=("--socket=$MYSQL_UNIX_PORT")
    else
        _MARIADB_ARGS=("-h" "$SERVER")
        [[ -n "${PORT:-}" ]] && _MARIADB_ARGS+=("-P" "$PORT")
    fi
}

# --- flag/option parsing (schematic-style, in bash) -------------------------
# _parse_flags <flags-spec> <options-spec> <args...>
#   flags-spec/options-spec: space-separated names (-f --force -q --quiet).
#   Bundled shorts (-nf) are split. Populates _POS_ARGS/_FLAGS/_OPTIONS.
_parse_flags() {
    local flags_spec="$1" options_spec="$2"
    shift 2
    _POS_ARGS=()
    _FLAGS=()
    _OPTIONS=()
    while [[ $# -gt 0 ]]; do
        local arg="$1"; shift
        if [[ "$arg" == "--" ]]; then
            _POS_ARGS+=("$@")
            break
        elif [[ "$arg" != -* ]]; then
            _POS_ARGS+=("$arg")
        elif _contains "$arg" $flags_spec; then
            _FLAGS+=("$arg")
        elif _contains "$arg" $options_spec; then
            if [[ $# -eq 0 ]]; then
                echo "Error: expected value for $arg" >&2
                exit 1
            fi
            _OPTIONS["$arg"]="$1"; shift
        elif [[ "$arg" =~ ^-[a-zA-Z0-9]{2,36}$ ]]; then
            # split up bundled short flags: -abc -> -a -b -c
            local i
            for (( i=1; i<${#arg}; i++ )); do
                set -- "-${arg:$i:1}" "$@"
            done
        else
            echo "Error: unexpected arg: $arg" >&2
            exit 1
        fi
    done
}

_contains() {
    local needle="$1"; shift
    local x
    for x in "$@"; do
        [[ "$x" == "$needle" ]] && return 0
    done
    return 1
}

_env_bool() {
    case "${1,,}" in
        1|yes|true|on) return 0 ;;
        *) return 1 ;;
    esac
}

# _get_flag <names...> — echo "yes"/"no". Short/long names check the parsed
# flags; bare names check the EMA_<NAME> env fallback (e.g. --force -> EMA_FORCE).
_get_flag() {
    local name
    for name in "$@"; do
        if [[ "$name" == -* ]]; then
            if _contains "$name" "${_FLAGS[@]}"; then echo "yes"; return; fi
        else
            local env_name="EMA_$(echo "$name" | tr '[:lower:]' '[:upper:]' | tr '-' '_')"
            if [[ -n "${!env_name:-}" ]] && _env_bool "${!env_name}"; then
                echo "yes"; return
            fi
        fi
    done
    echo "no"
}

# _get_option <name> [default] — parsed value first, then EMA_<NAME> fallback.
_get_option() {
    local name="$1" default="${2:-}"
    if [[ -n "${_OPTIONS[$name]+x}" ]]; then
        echo "${_OPTIONS[$name]}"
        return
    fi
    if [[ "$name" != -* ]]; then
        local env_name="EMA_$(echo "$name" | tr '[:lower:]' '[:upper:]' | tr '-' '_')"
        if [[ -n "${!env_name:-}" ]]; then
            echo "${!env_name}"
            return
        fi
    fi
    echo "$default"
}

# prompt_yesno <prompt> <default: yes|no> — schematic's prompt primitive.
# Reads a y/N or Y/n line; an empty/EOF answer falls back to the default.
prompt_yesno() {
    local prompt="$1" default="${2:-no}" answer
    local yes_default="no"
    case "${default,,}" in
        yes|y) yes_default="yes" ;;
    esac
    if [[ "$yes_default" == "yes" ]]; then
        read -r -p "$prompt (Y/n) " answer || true
    else
        read -r -p "$prompt (y/N) " answer || true
    fi
    case "${answer,,}" in
        y|yes) return 0 ;;
        n|no) return 1 ;;
        *) [[ "$yes_default" == "yes" ]] ;;
    esac
}

_is_help() {
    case "${1:-}" in
        help|-h|--help|-H|-help) return 0 ;;
        *) return 1 ;;
    esac
}

# --- per-instance sandbox server helpers (var/sandbox/<name>-<guid>) ---------
_sandbox_pid_value() {
    local pidfile
    pidfile="$(_sandbox_pid "$1")"
    if [[ -f "$pidfile" ]]; then
        cat "$pidfile"
    fi
}

_sandbox_up() {
    local pid
    pid="$(_sandbox_pid_value "$1")"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

_sandbox_start() {
    local key="$1" quiet="$2"
    if _sandbox_up "$key"; then
        [[ "$quiet" == "yes" ]] || echo "already running (pid $(_sandbox_pid_value "$key"))"
        return
    fi
    if [[ ! -d "$(_sandbox_data "$key")" ]]; then
        echo "Error: no data dir for sandbox '$key' — build it first ('ema sandbox ...')" >&2
        exit 1
    fi
    mkdir -p var/log
    # mysqld resolves RELATIVE --datadir/--pid-file/--socket against its own
    # basedir (e.g. the nix store prefix), not the CWD — absolutize like
    # bin/dev/init-cluster.sh does (mariadb-install-db has the same quirk).
    local datadir="$PWD/$(_sandbox_data "$key")"
    local pidfile="$PWD/$(_sandbox_pid "$key")"
    local sockfile="$PWD/$(_sandbox_sock "$key")"
    mysqld --datadir="$datadir" \
           --pid-file="$pidfile" \
           --socket="$sockfile" \
           --skip-networking >> var/log/mariadb.log 2>&1 &
    local i pid=""
    for (( i=0; i<50; i++ )); do
        pid="$(_sandbox_pid_value "$key")"
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            break
        fi
        sleep 0.1
    done
    if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
        echo "Error: MariaDB server failed to start for '$key' (see var/log/mariadb.log)" >&2
        exit 1
    fi
    [[ "$quiet" == "yes" ]] || echo "started (pid $pid)"
}

_sandbox_stop() {
    local key="$1" quiet="$2"
    local pid
    pid="$(_sandbox_pid_value "$key")"
    if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
        [[ "$quiet" == "yes" ]] || echo "not running"
        return
    fi
    # Graceful shutdown via mariadb-admin over the sandbox socket; fall back to
    # SIGTERM on the pid, then SIGKILL if it does not exit.
    if ! mariadb-admin -u root --socket="$(_sandbox_sock "$key")" shutdown >/dev/null 2>&1; then
        kill "$pid" 2>/dev/null || true
    fi
    local i
    for (( i=0; i<100; i++ )); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
        echo "Error: server did not stop gracefully — sending SIGKILL" >&2
        kill -9 "$pid" 2>/dev/null || true
        sleep 0.2
    fi
    [[ "$quiet" == "yes" ]] || echo "stopped"
}

_age() {
    local path="$1" now mtime diff
    if [[ ! -e "$path" ]]; then
        echo "-"
        return
    fi
    now=$(date +%s)
    mtime=$(stat -c %Y "$path")
    diff=$(( now - mtime ))
    if (( diff < 60 )); then
        echo "${diff}s"
    elif (( diff < 3600 )); then
        echo "$(( diff / 60 ))m"
    elif (( diff < 86400 )); then
        echo "$(( diff / 3600 ))h"
    else
        echo "$(( diff / 86400 ))d"
    fi
}

# --- commands ----------------------------------------------------------------

_help_schema() {
    cat <<'HELP'
Usage: ema schema <name>

Create a new schema package pkg/<name>-<GUID>/ with default.php and upgrade.sql.
HELP
}

_cmd_schema() {
    if _is_help "$@"; then
        _help_schema
        return
    fi
    if [[ -z "$1" ]]; then
        echo "Error: must provide a name for the schema" >&2
        _help_schema
        exit 1
    fi
    _assert_repo_root
    local prefix="$1"
    if ls -d "pkg/${prefix}"-* 1>/dev/null 2>&1; then
        echo "Error: Schema with prefix '$prefix' already exists in pkg/." >&2
        return 1
    fi
    local guid
    guid=$(_gen_guid S0)
    local directory_name="${prefix}-${guid}"
    mkdir -p "pkg/${directory_name}"
    touch "pkg/${directory_name}/upgrade.sql"
    cat <<EOD > "pkg/${directory_name}/default.php"
<?php
return new \\Ema\\Config\\PackageConfig();
EOD
    echo "Directory created: pkg/${directory_name}"
}

_help_mariadb() {
    cat <<'HELP'
Usage: ema mariadb <db> [args...]

Open a MariaDB shell against a database's section. Extra args are passed
through to the client (e.g. ema mariadb test -e "SHOW TABLES;"). Raw SQL
from a file uses stdin redirection: ema mariadb <db> < file.sql

The section is reached wherever its instance lives: on the instance's own host
the section's socket is used as root (unix_socket auth); anywhere else the
section's SERVER/PORT is used over TCP as DBUSER, which is required off-host.
Off-host the password comes from DBPASS (forwarded to the client as MYSQL_PWD),
else from the client's own sources (MYSQL_PWD, ~/.my.cnf); ema never asks for one
itself, so a passwordless account connects and any other must be fed one.
See doc/system/mariadb-remote.md.
HELP
}

# Off-host prod connection: the instance is not on this host, so the section's
# TCP endpoint is the only way in — the section's MYSQL_UNIX_PORT names a socket
# that exists on the instance's host, not here. DBUSER is required: ema never
# reaches an off-host instance as root, because root is a socket-auth identity
# (unix_socket maps the OS user) and this machine is not the instance's host.
# Sets _MARIADB_ARGS/_MARIADB_USER for _cmd_mariadb's client invocation.
_offhost_connect() {
    local dbname="$1"
    if [[ -z "${SERVER:-}" ]]; then
        echo "Error: section '$dbname' has no SERVER — cannot reach it from off-host" >&2
        exit 1
    fi
    if [[ -z "${PORT:-}" ]]; then
        echo "Error: section '$dbname' has no PORT — reaching it from off-host needs its TCP endpoint" >&2
        exit 1
    fi
    if [[ -z "${DBUSER:-}" ]]; then
        echo "Error: section '$dbname' is not on this host; set DBUSER to the SQL user to connect as" >&2
        exit 1
    fi
    _MARIADB_ARGS=(-h "$SERVER" -P "$PORT")
    _MARIADB_USER="$DBUSER"
    echo "$dbname is not on this host; connecting over tcp to $SERVER:$PORT as $DBUSER" >&2
}

# DBUSER connections take DBPASS, forwarded as the client's own MYSQL_PWD (env,
# never argv, nothing stored); the sandbox root path ignores it. Unset means ema
# supplies nothing, leaving the password to the client's own sources (~/.my.cnf,
# MYSQL_PWD in the caller's environment) — and to the client's own error when
# none of them supplies one. ema never adds the client's -p: a prompt is the
# caller's business, not the transport's.
_forward_dbpass() {
    if [[ -n "${DBPASS:-}" ]]; then
        export MYSQL_PWD="$DBPASS"
    fi
}

_cmd_mariadb() {
    if _is_help "$@"; then
        _help_mariadb
        return
    fi
    _assert_repo_root
    local dbname="" _args=("$@")
    if [ "${#_args[@]}" -gt 0 ] && [[ "${_args[0]}" != -* ]]; then
        dbname="${_args[0]}"
    fi
    _load_target "$dbname"
    if _is_sandbox || [[ -d "$_EMA_PROD_BASE/$dbname" ]]; then
        # This host owns the instance: the section's own endpoint — its socket
        # (as root, unix_socket auth) or its TCP address when the section
        # defines no socket. Sandbox instances are local by construction.
        _mariadb_args
        if _is_sandbox; then
            _MARIADB_USER="root"
        else
            _MARIADB_USER="${DBUSER:-$USER}"
            _forward_dbpass
        fi
    else
        _offhost_connect "$dbname"
        _forward_dbpass
    fi
    exec "$DBMS" -u "$_MARIADB_USER" "${_MARIADB_ARGS[@]}" "${_args[@]}"
}

# <prefix> + 14 random base36 chars -- schematic's type-prefixed GUID
# convention (16 chars total). The prefix maps a package to its kind: S0 for
# schema packages (pkg/), D0 for database packages (srv/).
_gen_guid() {
    local prefix="$1"
    local suffix
    suffix=$(tr -dc 'A-Z0-9' < /dev/urandom | fold -w 14 | head -n 1)
    printf '%s%s\n' "$prefix" "$suffix"
}

# Load srv/<name>-<GUID>/default.php and print its definition as JSON
# ({"dir":..., "db":{...}, "dependencies":[...]}).
_srv_definition() {
    php -r "
        require '${_EMA_LIB}/sort_schemas.php';
        echo json_encode(srv_definition('$1'));
    "
}

# Write the per-instance var/sandbox/<key>/reuter.ini with a [<dbname>]
# section (endpoint keys only — ema creates schema, never users/passwords).
# Written once on build; instances are create-only (gc first to rebuild).
_write_sandbox_ini() {
    local key="$1" dbname="$2"
    local ini
    ini="$(_sandbox_ini "$key")"
    mkdir -p "$(dirname "$ini")"
    cat > "$ini" <<EOF
; Generated by ema sandbox — machine-local (git-ignored).
; One [<dbname>] section per sandbox instance; the header IS the database name.
[$dbname]
SERVER=localhost
PORT=0
DBNAME=$dbname
MYSQL_UNIX_PORT=$(_sandbox_sock "$key")
EOF
}

# Run a SQL file as root against the loaded connection (after _load_section +
# _mariadb_args). <dbname> may be empty (bootstrap SQL creates/uses its own
# database via {{dbname}}). Falls back to sudo for system installs where the
# root socket requires elevation; the sandbox itself stays user-owned.
_run_root_sql() {
    local dbname="$1" sqlfile="$2"
    local args=(-u root "${_MARIADB_ARGS[@]}")
    if [[ -n "$dbname" ]]; then
        args+=("$dbname")
    fi
    if ! "$DBMS" "${args[@]}" < "$sqlfile" 2>/dev/null; then
        sudo env PATH="$PATH" MYSQL_UNIX_PORT="$MYSQL_UNIX_PORT" "$DBMS" "${args[@]}" < "$sqlfile"
    fi
}

# True when database <dbname> exists on the resolved connection
# (information_schema.SCHEMATA). Called after _load_section + _mariadb_args;
# 'ema create' refuses when this is true (create-only). SELECT only.
_prod_database_exists() {
    local dbname="$1" out
    local sql="SELECT SCHEMA_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = '${dbname}';"
    out=$("$DBMS" -N -u root "${_MARIADB_ARGS[@]}" -e "$sql" 2>/dev/null) || \
        out=$(sudo env PATH="$PATH" MYSQL_UNIX_PORT="${MYSQL_UNIX_PORT:-}" "$DBMS" -N -u root "${_MARIADB_ARGS[@]}" -e "$sql")
    [[ -n "$out" ]]
}

# Shared streaming primitive: topo-sort the package graph rooted at
# root_pkgs..., concatenate each package's upgrade.sql, wrap it in FK guards,
# and fill {{dbname}} — writing the result to <outfile>.
_build_schema_sql() {
    local dbname="$1" outfile="$2"
    shift 2
    local root_pkgs=("$@") roots_json="" r
    for r in "${root_pkgs[@]}"; do
        [[ -n "$roots_json" ]] && roots_json+=","
        roots_json+="\"$r\""
    done
    roots_json="[$roots_json]"
    local schemas_json
    schemas_json=$(php -r "
        require '${_EMA_LIB}/sort_schemas.php';
        \$graph = build_dependency_graph_roots(json_decode('${roots_json}', true));
        echo json_encode(\$graph->topological_sort());
    ") || exit 1
    local schemas_array
    mapfile -t schemas_array < <(echo "$schemas_json" | jq -r '.[]')
    local workdir pseudo_sql schema schema_dir
    workdir=$(mktemp -d /tmp/table_schemas_XXXXXX)
    pseudo_sql="${workdir}/pseudo_query.sql"
    for schema in "${schemas_array[@]}"; do
        schema_dir="$(_find_package "$schema")" || {
            echo "Error: schema package '$schema' not found" >&2
            rm -r "$workdir"
            return 1
        }
        if [[ -f "$schema_dir/upgrade.sql" ]]; then
            cat "$schema_dir/upgrade.sql" >> "$pseudo_sql"
            echo "" >> "$pseudo_sql"
        fi
    done
    { echo "SET FOREIGN_KEY_CHECKS=0;"; \
      sed "s/{{dbname}}/${dbname}/g;" "$pseudo_sql"; \
      echo "SET FOREIGN_KEY_CHECKS=1;"; } > "$outfile"
    rm -r "$workdir"
}

# Apply the dependency graph of root_pkgs... to <dbname> (non-destructive:
# CREATE OR REPLACE, no DROP).
_apply_pkg_graph() {
    local dbname="$1"
    shift
    local root_pkgs=("$@") workdir sql
    workdir=$(mktemp -d /tmp/ema_schema_XXXXXX)
    sql="${workdir}/query.sql"
    _build_schema_sql "$dbname" "$sql" "${root_pkgs[@]}" || { rm -r "$workdir"; exit 1; }
    _run_root_sql "$dbname" "$sql"
    rm -r "$workdir"
}

# Build the srv bootstrap SQL into <outfile>: read srv/<name>-<GUID>/upgrade.sql
# and fill {{dbname}}/{{charset}}/{{collation}} from default.php defaults.
# Database DDL only — users/grants are consumer policy and never emitted.
_build_srv_bootstrap_sql() {
    local srv_dir="$1" outfile="$2"
    local defs dbname charset collation
    defs=$(php -r "
        require '${_EMA_LIB}/Config/DatabaseConfig.php';
        try {
            \$config = require '${srv_dir}/default.php';
        } catch (\Throwable \$e) {
            fwrite(STDERR, 'Error: ${srv_dir}/default.php: ' . \$e->getMessage() . PHP_EOL);
            exit(1);
        }
        if (!\$config instanceof \Ema\Config\DatabaseConfig) {
            fwrite(STDERR, 'Error: ${srv_dir}/default.php must return an \Ema\Config\DatabaseConfig' . PHP_EOL);
            exit(1);
        }
        echo json_encode(\$config->toArray());
    ") || exit 1
    dbname=$(echo "$defs" | jq -r '.dbname')
    charset=$(echo "$defs" | jq -r '.charset')
    collation=$(echo "$defs" | jq -r '.collation')
    sed "s/{{dbname}}/${dbname}/g; s/{{charset}}/${charset}/g; s/{{collation}}/${collation}/g;" \
        "${srv_dir}/upgrade.sql" > "$outfile"
}

# Synthesize the bootstrap SQL for a pkg/ sandbox (no srv package): a default
# database (charset/collation defaults). Database DDL only.
_build_synth_bootstrap_sql() {
    local dbname="$1" charset="$2" collation="$3" outfile="$4"
    cat > "$outfile" <<EOF
SET check_constraint_checks = OFF;
DROP DATABASE IF EXISTS ${dbname};
CREATE OR REPLACE DATABASE ${dbname}
COMMENT 'ema ${dbname} database'
CHARACTER SET = '${charset}'
COLLATE = '${collation}';
EOF
}

# After a successful init, open the shell unless -n/--no-shell, in which case
# print the command instead. When stdin is not a terminal (pipes, CI), print
# the command too so scripts never block. The sandbox build has already loaded
# its own connection (see _sandbox_build), so the client is opened in-process
# with those args rather than through 'ema mariadb' — which is EMA_TARGET-driven
# and would not find the instance.
_maybe_open_shell() {
    local dbname="$1" no_shell
    no_shell=$(_get_flag --no-shell -n no_shell)
    if [[ "$no_shell" == "yes" ]]; then
        echo "Run: EMA_TARGET=sandbox ema mariadb $dbname"
    elif [[ -t 0 ]]; then
        echo "Opening shell for $dbname (use -n/--no-shell to skip)..."
        exec "$DBMS" -u root "${_MARIADB_ARGS[@]}"
    else
        echo "Run: EMA_TARGET=sandbox ema mariadb $dbname"
    fi
}

# --- prod per-database instances --------------------------------------------
# ema provisions the per-database instance's DATA (datadir, socket, pid, log,
# config) and starts/stops the mariadb@<db> systemd unit. The unit itself is a
# static file installed by the host's provisioning, NOT authored here — ema
# only asserts it exists and refuses cleanly when missing, so an abort never
# leaves a half-provisioned instance. Layout (root-owned; systemd for boot
# durability):
#   datadir   = $EMA_PROD_BASE/<db>/data
#   socket    = $EMA_PROD_BASE/<db>/mysql.sock
#   pid-file  = $EMA_PROD_BASE/<db>/mysql.pid
#   log-error = $EMA_PROD_BASE/<db>/mariadb.log
#   config    = ${EMA_PROD_CONF_DIR:-/etc}/<db>/my.cnf
#   unit      = mariadb@<db>   (host-provisioned; --defaults-file=/etc/%i/my.cnf)
# The MariaDB client binary. ema is MariaDB-only, so DBMS is a constant; the
# reuter.ini section carries connection values (SERVER/PORT/MYSQL_UNIX_PORT)
# only. _load_section leaves DBMS alone, so this is the single source.
DBMS="${DBMS:-mariadb}"

# The shipped unit pins its defaults-file to /etc, so EMA_PROD_CONF_DIR only
# takes effect together with a matching unit.
# The per-instance my.cnf shields the daemon from the global /etc/mysql/
# includes (which would inject the distro socket/port/pid paths and collide
# with other instances on the same host). The defaults are overridable for
# non-Debian layouts and testing.
_EMA_PROD_BASE="${EMA_PROD_BASE:-/var/lib/mariadb}"
_prod_data()      { echo "$_EMA_PROD_BASE/$1/data"; }
_prod_sock()      { echo "$_EMA_PROD_BASE/$1/mysql.sock"; }
_prod_pid()       { echo "$_EMA_PROD_BASE/$1/mysql.pid"; }
_prod_log()       { echo "$_EMA_PROD_BASE/$1/mariadb.log"; }
_prod_binlog()    { echo "$_EMA_PROD_BASE/$1/binlog"; }
_prod_conf_base() { echo "${EMA_PROD_CONF_DIR:-/etc}"; }
_prod_conf_file() { echo "$(_prod_conf_base)/$1/my.cnf"; }
_prod_unit()      { echo "mariadb@$1"; }
_prod_user()      { echo "${EMA_PROD_USER:-mysql}"; }
_prod_bind()      { echo "${EMA_PROD_BIND:-0.0.0.0}"; }

# Pick a free TCP port with a kernel-assigned ephemeral bind (bind to port 0,
# read the port, release). Inherently racy: the caller re-picks when a start
# loses the race, and never re-picks a running instance's port.
_get_free_port() {
    php -r '
        $sock = @stream_socket_server("tcp://0.0.0.0:0", $errno, $errstr);
        if ($sock === false) {
            fwrite(STDERR, "Error: cannot bind an ephemeral port: $errstr\n");
            exit(1);
        }
        $name = stream_socket_get_name($sock, false);
        echo substr($name, strrpos($name, ":") + 1);
        fclose($sock);
    '
}

# True when nothing is listening on TCP <port> (a fresh bind succeeds).
_port_free() {
    php -r '
        $sock = @stream_socket_server("tcp://0.0.0.0:" . (int) $argv[1], $errno, $errstr);
        if ($sock === false) { exit(1); }
        fclose($sock);
    ' "$1"
}

# The address prod sections advertise (SERVER): the host's overlay IP.
# EMA_SERVER overrides; otherwise the first global IPv4 on a ZeroTier
# interface (zt*), then the first global IPv4, then localhost.
_prod_server_addr() {
    if [[ -n "${EMA_SERVER:-}" ]]; then
        echo "$EMA_SERVER"
        return
    fi
    local addr=""
    if command -v ip >/dev/null 2>&1; then
        addr=$(ip -4 -o addr show scope global 2>/dev/null \
            | awk '$2 ~ /^zt/ { sub(/\/.*/, "", $4); print $4; exit }')
        [[ -z "$addr" ]] && addr=$(ip -4 -o addr show scope global 2>/dev/null \
            | awk 'NR == 1 { sub(/\/.*/, "", $4); print $4 }')
    fi
    echo "${addr:-localhost}"
}

# Read the persisted port from an instance defaults file.
_prod_conf_port() {
    awk -F= '/^[[:space:]]*port[[:space:]]*=/ { gsub(/[[:space:]]/, "", $2); print $2; exit }' "$1"
}

# A stable, distinct server_id for a replica instance, derived from its name.
# MariaDB requires every server in a replication topology to carry a unique
# server_id; ema's primary instances leave the server default (1), so a
# replica must not collide with it. Deterministic so re-provisioning the same
# replica name yields the same value.
_replica_server_id() {
    local n
    n=$(php -r 'echo (int)((crc32($argv[1]) % 2147483646) + 1);' "$1")
    [[ "$n" == "1" ]] && n=2
    echo "$n"
}

# Write the per-instance defaults file (idempotent). <extra>, when non-empty,
# is appended verbatim to the [mysqld] group — used by the replica build to add
# read_only / replicate-rewrite-db / server_id without a second copy of the
# whole file. <binlog> (yes/no, default no) writes the binary-log block
# (log_bin + binlog_format=ROW + expire_logs_days) that makes a primary a
# replication source (or a point-in-time-recovery/CDC source); it is opt-in
# via the package's `binlog: true`, and a replica never sets it
# (read_only, and chained replication is out of scope). <expire> (days,
# default 7) is the per-package retention (`binlog_expire_days`).
_prod_write_conf() {
    local db="$1" port="$2" user="$3" extra="${4:-}" binlog="${5:-no}" expire="${6:-7}" dir
    dir="$(_prod_conf_base)/$db"
    mkdir -p "$dir"
    {
        echo "[mysqld]"
        echo "datadir      = $(_prod_data "$db")"
        echo "socket       = $(_prod_sock "$db")"
        echo "pid-file     = $(_prod_pid "$db")"
        echo "log-error    = $(_prod_log "$db")"
        echo "user         = $user"
        echo "port         = $port"
        echo "bind-address = $(_prod_bind)"
        if [[ "$binlog" == "yes" ]]; then
            echo "log_bin          = $(_prod_binlog "$db")"
            echo "binlog_format    = ROW"
            echo "expire_logs_days = $expire"
        fi
        [[ -n "$extra" ]] && printf '%s\n' "$extra"
    } > "$(_prod_conf_file "$db")"
    chmod 644 "$(_prod_conf_file "$db")"
}

# The mariadb@.service template unit is a static file installed by the host's
# provisioning, NOT authored here. ema only asserts it exists before touching
# anything, so an interrupted run can never leave a half-provisioned instance
# (a conf/datadir with no unit to start it).
_prod_unit_file() { echo "/etc/systemd/system/mariadb@.service"; }

_prod_require_unit() {
    local unit_file
    unit_file="$(_prod_unit_file)"
    if [[ ! -f "$unit_file" ]]; then
        echo "Error: systemd unit '$unit_file' not found" >&2
        echo "The mariadb@.service template is host-provisioned (a static unit" >&2
        echo "installed by the deploy/provision layer), not authored by ema — install" >&2
        echo "it before running ema create." >&2
        exit 1
    fi
}

# Wait (bounded) until <unit> is active AND accepting TCP on <port>.
_prod_wait_listening() {
    local unit="$1" port="$2" i
    for (( i=0; i<50; i++ )); do
        if systemctl is-active --quiet "$unit" 2>/dev/null && ! _port_free "$port"; then
            return 0
        fi
        if (( i > 5 )) && ! systemctl is-active --quiet "$unit" 2>/dev/null; then
            return 1
        fi
        sleep 0.1
    done
    return 1
}

# Ensure the per-database instance exists and is running; sets _PROD_PORT and
# _PROD_SOCKET. Idempotent: an existing defaults file is authoritative (its
# port is never re-picked). On first provision the port is auto-picked and the
# instance is initialized + started; a lost start race re-picks a new port.
_prod_instance_ensure() {
    local db="$1" quiet="$2" binlog="${3:-no}" expire="${4:-7}"
    local datadir conffile unit user attempt port
    datadir="$(_prod_data "$db")"
    conffile="$(_prod_conf_file "$db")"
    unit="$(_prod_unit "$db")"
    user="$(_prod_user "$db")"
    _PROD_SOCKET="$(_prod_sock "$db")"

    if ! id -u "$user" >/dev/null 2>&1; then
        echo "Error: system user '$user' does not exist (override with EMA_PROD_USER)" >&2
        exit 1
    fi

    _prod_require_unit

    if [[ -f "$conffile" ]]; then
        _PROD_PORT="$(_prod_conf_port "$conffile")"
        if [[ -z "$_PROD_PORT" ]]; then
            echo "Error: no port in $conffile" >&2
            exit 1
        fi
        if systemctl is-active --quiet "$unit" 2>/dev/null; then
            [[ "$quiet" == "no" ]] && echo "    Instance $unit already running (port $_PROD_PORT)."
            return
        fi
        [[ "$quiet" == "no" ]] && echo "    Starting instance $unit (port $_PROD_PORT)..."
        systemctl start "$unit"
        _prod_wait_listening "$unit" "$_PROD_PORT" || {
            echo "Error: instance $unit did not accept connections on port $_PROD_PORT" >&2
            exit 1
        }
        return
    fi

    # First provision: pick a port, initialize the datadir, install the unit.
    for attempt in 1 2 3; do
        port="$(_get_free_port)"
        mkdir -p "$datadir"
        chown -R "$user:$user" "$_EMA_PROD_BASE/$db"
        _prod_write_conf "$db" "$port" "$user" "" "$binlog" "$expire"
        if [[ -z "$(ls -A "$datadir" 2>/dev/null)" ]]; then
            [[ "$quiet" == "no" ]] && echo "    Initializing MariaDB datadir for '$db'..."
            mariadb-install-db --skip-test-db --user="$user" --datadir="$datadir" >/dev/null 2>&1 || {
                echo "Error: mariadb-install-db failed for '$db'" >&2
                exit 1
            }
        fi
        if systemctl enable --now "$unit" 2>/dev/null && _prod_wait_listening "$unit" "$port"; then
            _PROD_PORT="$port"
            [[ "$quiet" == "no" ]] && echo "    Instance $unit created (port $port)."
            return
        fi
        # Lost the port race (or the unit failed to start): tear the inactive
        # unit down and retry with a fresh port. Never re-pick a running
        # instance's port.
        echo "Warning: instance $unit did not come up on port $port; retrying with a new port" >&2
        systemctl stop "$unit" 2>/dev/null || true
        rm -f "$conffile"
    done
    echo "Error: could not start instance $unit after 3 attempts" >&2
    exit 1
}

# Print the reuter.ini section shape for a prod database, for the operator to
# record in the consumer's manual reuter.ini. Used by `create` (on success)
# and `values` (recovery).
_prod_print_values() {
    local db="$1" port="$2" sock="$3"
    cat <<EOF

Record this section in reuter.ini:

[$db]
SERVER=$(_prod_server_addr)
PORT=$port
MYSQL_UNIX_PORT=$sock
EOF
}

# --- prod database creation (prod instances) ---------------------------------

_help_create() {
    cat <<'HELP'
Usage: ema create srv/<name>-<GUID> [flags]

Provision a prod database from a database package: ensure the database's own
MariaDB instance exists and is running (datadir, /etc/<db>/my.cnf, an
auto-picked TCP port, the mariadb@<db> systemd unit), then create the database
(dbname/charset/collation) and apply the schema-package dependency graph in
topological order. On success the connectivity values (SERVER/PORT/
MYSQL_UNIX_PORT for the [<db>] section) are printed for the operator to record
in the consumer's manual reuter.ini. Schema only — users/grants are consumer
policy and are never created by ema.

Always operates on prod (build a sandbox with 'ema sandbox
srv/<name>-<GUID>'). Create-only: refuses when the database already exists
(delete it first over the section's socket). There is no reapply/upgrade
surface — change a database with imperative SQL or delete + recreate.

Flags:
  -n, --dry-run     Print the SQL that would run, without provisioning or running it
  --from-snapshot <path>
                    (replica only) restore this mariadb-backup backup instead of
                    applying schema — required for a type=replica package
  -q, --quiet       Suppress non-error output
  -v, --verbose     Print the action to stderr

Replica: a package with type: 'replica' and replica_of: <primary>
is built from the primary's shipped snapshot (--from-snapshot <path>) and
attached over the low-priv 'replication' account — schema arrives via
replication, so no schema packages are applied. See
doc/system/replica-bootstrap.md for the manual bootstrap.
HELP
}

_cmd_create() {
    if _is_help "$@"; then
        _help_create
        return
    fi
    _parse_flags "--dry-run -n -q --quiet -v --verbose" "--from-snapshot" "$@"
    local target="${_POS_ARGS[0]:-}"
    if [[ -z "$target" ]]; then
        echo "Error: must provide a target (e.g., ema create srv/<name>-<GUID>)" >&2
        _help_create
        exit 1
    fi
    _assert_repo_root
    if [[ "$target" != srv/* ]]; then
        echo "Error: target must be srv/<name>-<GUID> (got '$target')" >&2
        _help_create
        exit 1
    fi
    local dry_run quiet verbose
    dry_run=$(_get_flag --dry-run -n dry_run)
    quiet=$(_get_flag --quiet -q quiet)
    verbose=$(_get_flag --verbose -v verbose)
    local ref defs dbname srv_dir deps_json
    local -a deps=()
    ref="${target#srv/}"
    defs="$(_srv_definition "$ref")" || exit 1
    dbname=$(echo "$defs" | jq -r '.db.dbname')
    if [[ -z "$dbname" || "$dbname" == "null" ]]; then
        echo "Error: srv/$ref/default.php has no dbname (return an \Ema\Config\DatabaseConfig with dbname set)" >&2
        exit 1
    fi
    # A replica package (type=replica, replica_of=<primary>) takes the
    # dedicated local-only build path: restore the primary's shipped snapshot,
    # then attach over the low-priv `replication` account — no schema apply.
    local db_type replica_of db_binlog db_binlog_expire db_replica_ssl_verify
    db_type=$(echo "$defs" | jq -r '.db.type // "primary"')
    replica_of=$(echo "$defs" | jq -r '.db.replica_of // ""')
    db_binlog=$(echo "$defs" | jq -r 'if .db.binlog == true then "yes" else "no" end')
    db_binlog_expire=$(echo "$defs" | jq -r '.db.binlog_expire_days // 7')
    # replica only: `replica_ssl_verify_server_cert: true` makes the replica
    # verify the primary's server certificate; default off because that
    # certificate is the self-signed one MariaDB generates unless a consumer
    # provisions a CA, and verifying a self-signed cert fails the IO thread.
    db_replica_ssl_verify=$(echo "$defs" | jq -r 'if .db.replica_ssl_verify_server_cert == true then "1" else "0" end')
    if [[ "$db_type" == "replica" ]]; then
        _cmd_create_replica "$dbname" "$replica_of" "$db_replica_ssl_verify"
        return
    fi
    srv_dir=$(echo "$defs" | jq -r '.dir')
    deps_json=$(echo "$defs" | jq -c '.dependencies')
    mapfile -t deps < <(echo "$deps_json" | jq -r '.[]')
    # Build the bootstrap + dependency SQL up front (no connection needed), so
    # --dry-run can print it without provisioning anything.
    local workdir bootstrap_sql apply_sql has_deps="no"
    workdir=$(mktemp -d /tmp/ema_create_XXXXXX)
    bootstrap_sql="${workdir}/bootstrap.sql"
    _build_srv_bootstrap_sql "$srv_dir" "$bootstrap_sql"
    if [[ "${#deps[@]}" -gt 0 ]]; then
        has_deps="yes"
        apply_sql="${workdir}/apply.sql"
        _build_schema_sql "$dbname" "$apply_sql" "${deps[@]}" || { rm -r "$workdir"; exit 1; }
    fi
    if [[ "$dry_run" == "yes" ]]; then
        cat "$bootstrap_sql"
        if [[ "$has_deps" == "yes" ]]; then
            cat "$apply_sql"
        fi
        rm -r "$workdir"
        return
    fi
    # Ensure (or reuse) the database's own instance BEFORE creating the
    # database; ema owns prod instance provisioning, the operator only records
    # the emitted connectivity values in the consumer's manual reuter.ini.
    _prod_instance_ensure "$dbname" "$quiet" "$db_binlog" "$db_binlog_expire"
    # Connect as root over the instance's own socket (unix_socket auth); the
    # consumer's reuter.ini section does not exist yet.
    MYSQL_UNIX_PORT="$_PROD_SOCKET"
    _mariadb_args
    if _prod_database_exists "$dbname"; then
        rm -r "$workdir"
        echo "Error: database '$dbname' already exists — ema create is create-only (drop it first: DROP DATABASE $dbname)" >&2
        exit 1
    fi
    [[ "$verbose" == "yes" ]] && echo "Creating database: $dbname" >&2
    _run_root_sql "" "$bootstrap_sql"
    if [[ "$has_deps" == "yes" ]]; then
        _run_root_sql "$dbname" "$apply_sql"
    fi
    rm -r "$workdir"
    [[ "$quiet" == "no" ]] && echo "Created database: $dbname"
    _prod_print_values "$dbname" "$_PROD_PORT" "$_PROD_SOCKET"
}

# Build a read-only replica (type=replica, replica_of=<primary>) from the
# primary's shipped snapshot. Local-only: it runs on the replica host and never
# reaches the primary as root — the only primary interaction is reading its
# `[<primary>]` section for MASTER_HOST/MASTER_PORT; the replica daemon then
# authenticates over the low-priv `replication` account (created beforehand by
# the manual bootstrap). Three gates fail loudly:
#   1. --from-snapshot absent/unreadable  -> abort before provisioning;
#   2. snapshot carries no binlog file/pos -> abort at restore (the primary was
#      not replication-ready, or the snapshot is not a mariadb-backup backup);
#   3. Slave_IO_Running != Yes after START SLAVE -> abort (missing/mis-pinned
#      replication account, unreachable primary, or a wrong-source snapshot).
# <ssl_verify> (1/0, default 0) is emitted as MASTER_SSL_VERIFY_SERVER_CERT, so
# the channel's trust posture is the package's choice and never MariaDB's
# implicit default.
_cmd_create_replica() {
    local dbname="$1" replica_of="$2" ssl_verify="${3:-0}"
    local from_snapshot dry_run quiet verbose
    from_snapshot=$(_get_option --from-snapshot)
    dry_run=$(_get_flag --dry-run -n dry_run)
    quiet=$(_get_flag --quiet -q quiet)
    verbose=$(_get_flag --verbose -v verbose)

    if [[ -z "$replica_of" ]]; then
        echo "Error: srv package for '$dbname' is type=replica but has no replica_of (primary name required)" >&2
        exit 1
    fi

    # Gate 1: the shipped snapshot is a required, explicit input.
    if [[ -z "$from_snapshot" ]]; then
        echo "Error: '$dbname' is a replica (type=replica) — 'ema create' requires --from-snapshot <path>" >&2
        echo "       Run the manual bootstrap first (see doc/system/replica-bootstrap.md)." >&2
        exit 1
    fi
    if [[ ! -d "$from_snapshot" ]]; then
        echo "Error: --from-snapshot '$from_snapshot' is not a directory (expected a mariadb-backup backup)" >&2
        exit 1
    fi

    # The snapshot records its replication coordinate in mariadb_backup_info
    # (or xtrabackup_info on older tooling). MariaDB has no server_uuid; the
    # coordinate is the binlog file + position (file/pos — GTID resume is the
    # preferred future refinement tracked as an Open item).
    local snapshot_info snapshot_file snapshot_pos
    snapshot_info="$from_snapshot/mariadb_backup_info"
    [[ -f "$snapshot_info" ]] || snapshot_info="$from_snapshot/xtrabackup_info"
    if [[ ! -f "$snapshot_info" ]]; then
        echo "Error: '$from_snapshot' is not a mariadb-backup backup (missing mariadb_backup_info/xtrabackup_info)" >&2
        exit 1
    fi
    snapshot_file=$(sed -n "s/^.*filename '\([^']*\)'.*\$/\1/p" "$snapshot_info")
    snapshot_pos=$(sed -n "s/^.*position '\([0-9]*\)'.*\$/\1/p" "$snapshot_info")

    # Gate 2: the snapshot must carry a binlog file/pos (a primary with binlog
    # enabled). A wrong-source snapshot is not detectable here (MariaDB records
    # no server_uuid); its file/pos simply will not reconcile with the real
    # primary and is caught by gate 3 below.
    if [[ -z "$snapshot_file" || -z "$snapshot_pos" ]]; then
        echo "Error: snapshot '$from_snapshot' records no binlog file/pos — the primary must have binlog enabled" >&2
        exit 1
    fi

    # Read the primary's section for the replica's MASTER_* endpoint — the prod
    # file directly: this path is inherently prod, so the flag has no say.
    _load_section "$(_prod_reuter_file)" "$replica_of"
    local master_host="${SERVER:-localhost}" master_port="${PORT:-}"
    if [[ -z "$master_port" ]]; then
        echo "Error: primary section '[$replica_of]' has no PORT — replication needs the primary's TCP endpoint" >&2
        exit 1
    fi

    if [[ "$dry_run" == "yes" ]]; then
        cat <<EOF
Replica build (dry-run):
  replica:   $dbname
  primary:   $replica_of
  snapshot:  $from_snapshot
  resume:    $snapshot_file:$snapshot_pos
  read_only: 1
  rewrite:   $replica_of->$dbname
  CHANGE MASTER TO MASTER_HOST='$master_host', MASTER_PORT=$master_port, MASTER_USER='replication', MASTER_LOG_FILE='$snapshot_file', MASTER_LOG_POS=$snapshot_pos, MASTER_SSL_VERIFY_SERVER_CERT=$ssl_verify;
EOF
        return
    fi

    local user datadir conffile unit replica_conf
    user="$(_prod_user)"
    if ! id -u "$user" >/dev/null 2>&1; then
        echo "Error: system user '$user' does not exist (override with EMA_PROD_USER)" >&2
        exit 1
    fi
    conffile="$(_prod_conf_file "$dbname")"
    if [[ -f "$conffile" ]]; then
        echo "Error: instance '$dbname' already exists ($conffile present) — ema create is create-only" >&2
        exit 1
    fi
    datadir="$(_prod_data "$dbname")"
    unit="$(_prod_unit "$dbname")"
    _prod_require_unit
    replica_conf="read_only = 1
replicate-rewrite-db = $replica_of->$dbname
server_id = $(_replica_server_id "$dbname")"

    # Prepare the snapshot once (skip when the backup is already prepared:
    # mariadb_backup_checkpoints' backup_type is 'log-applied').
    local checkpoints backup_type
    checkpoints="$from_snapshot/mariadb_backup_checkpoints"
    [[ -f "$checkpoints" ]] || checkpoints="$from_snapshot/xtrabackup_checkpoints"
    backup_type=$(awk -F= '/^[[:space:]]*backup_type[[:space:]]*=/{ gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit }' "$checkpoints" 2>/dev/null)
    if [[ "$backup_type" != "log-applied" ]]; then
        [[ "$verbose" == "yes" ]] && echo "Preparing snapshot: $from_snapshot" >&2
        mariadb-backup --prepare --target-dir="$from_snapshot" >/dev/null 2>&1 || {
            echo "Error: mariadb-backup --prepare failed for '$from_snapshot'" >&2
            exit 1
        }
    fi

    # Provision the replica instance + restore the snapshot into its (empty)
    # datadir. Unlike a primary there is no mariadb-install-db: the snapshot
    # carries the system tables. Auto-pick a port; retry only a lost start race
    # with a fresh port (never re-pick a running instance's port).
    local port
    for attempt in 1 2 3; do
        port="$(_get_free_port)"
        mkdir -p "$datadir"
        chown -R "$user:$user" "$_EMA_PROD_BASE/$dbname"
        _prod_write_conf "$dbname" "$port" "$user" "$replica_conf" "no"
        if [[ ! -f "$datadir/ibdata1" ]]; then
            [[ "$verbose" == "yes" ]] && echo "Restoring snapshot into: $datadir" >&2
            mariadb-backup --copy-back --target-dir="$from_snapshot" --datadir="$datadir" >/dev/null 2>&1 || {
                echo "Error: mariadb-backup --copy-back failed into '$datadir'" >&2
                exit 1
            }
            chown -R "$user:$user" "$_EMA_PROD_BASE/$dbname"
        fi
        if systemctl enable --now "$unit" 2>/dev/null && _prod_wait_listening "$unit" "$port"; then
            _PROD_PORT="$port"
            break
        fi
        echo "Warning: replica instance $unit did not come up on port $port; retrying with a new port" >&2
        systemctl stop "$unit" 2>/dev/null || true
        rm -f "$conffile"
        port=""
    done
    if [[ -z "$port" ]]; then
        echo "Error: could not start replica instance $dbname after 3 attempts" >&2
        exit 1
    fi

    # Attach the replica to the primary over the low-priv replication account
    # (never root): resume from the snapshot's file/pos, then START SLAVE.
    _PROD_SOCKET="$(_prod_sock "$dbname")"
    MYSQL_UNIX_PORT="$_PROD_SOCKET"
    _mariadb_args
    local workdir replica_sql
    workdir=$(mktemp -d /tmp/ema_replica_XXXXXX)
    replica_sql="${workdir}/replica.sql"
    cat > "$replica_sql" <<EOF
CHANGE MASTER TO MASTER_HOST='${master_host}', MASTER_PORT=${master_port}, MASTER_USER='replication', MASTER_LOG_FILE='${snapshot_file}', MASTER_LOG_POS=${snapshot_pos}, MASTER_SSL_VERIFY_SERVER_CERT=${ssl_verify};
START SLAVE;
EOF
    [[ "$verbose" == "yes" ]] && echo "Attaching replica '$dbname' to primary '$replica_of'..." >&2
    if ! _run_root_sql "" "$replica_sql"; then
        rm -r "$workdir"
        echo "Error: failed to configure/start replication for '$dbname'" >&2
        exit 1
    fi
    rm -r "$workdir"

    # Gate 3: the IO thread must be running. A missing/mis-pinned replication
    # account, an unreachable primary, or a wrong-source snapshot all leave
    # Slave_IO_Running != Yes.
    local slave_io
    slave_io=$("$DBMS" -u root "${_MARIADB_ARGS[@]}" -e "SHOW SLAVE STATUS\G" 2>/dev/null \
        | awk -F: '/Slave_IO_Running/{ gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit }')
    if [[ "$slave_io" != "Yes" ]]; then
        echo "Error: replica '$dbname' Slave_IO_Running is '${slave_io:-unset}' (expected Yes) — check the replication account on the primary (see doc/system/replica-bootstrap.md)" >&2
        exit 1
    fi

    [[ "$quiet" == "no" ]] && echo "Created replica: $dbname (of $replica_of)"
    _prod_print_values "$dbname" "$_PROD_PORT" "$_PROD_SOCKET"
}

