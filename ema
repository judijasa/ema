_help_sandbox() {
    cat <<'HELP'
Usage: ema sandbox <target> [flags]

Build a disposable per-instance sandbox for a database or schema package.
Each sandbox owns its MariaDB instance (datadir/socket/pid under
var/sandbox/<name>-<guid>/).

Targets:
  srv/<name>-<GUID>   Create the instance + database (bootstrap from the srv
                      package's upgrade.sql) + apply the schema-package deps
                      in topological order.
  pkg/<pkg>-<GUID>    Synthesize a default database (zero deps) and apply the
                      pkg's dependency graph.

Create-only: re-running against an existing instance refuses ("already built —
'ema gc var/sandbox/<key>' first"). Schema only — users/grants are consumer
policy and are never created by ema.

Flags:
  -n, --no-shell      Print 'ema mariadb <db>' instead of opening the shell
  -q, --quiet         Suppress non-error output
HELP
}

_cmd_sandbox() {
    if _is_help "$@"; then
        _help_sandbox
        return
    fi
    _parse_flags "-n --no-shell -q --quiet -v --verbose" "" "$@"
    local target="${_POS_ARGS[0]:-}"
    if [[ -z "$target" ]]; then
        echo "Error: must provide a target (e.g., ema sandbox srv/test-D01B9X95PUIWQ60Q)" >&2
        _help_sandbox
        exit 1
    fi
    _assert_repo_root
    if [[ "$target" == srv/* ]]; then
        _sandbox_srv "$target"
    elif [[ "$target" == pkg/* ]]; then
        _sandbox_pkg "$target"
    else
        echo "Error: target must be srv/<name>-<GUID> or pkg/<pkg>-<GUID> (got '$target')" >&2
        _help_sandbox
        exit 1
    fi
}

# Build a sandbox for an srv/<name>-<GUID> database package.
_sandbox_srv() {
    local target="$1" ref defs dbname srv_dir deps_json key
    ref="${target#srv/}"
    defs="$(_srv_definition "$ref")" || exit 1
    dbname=$(echo "$defs" | jq -r '.db.dbname')
    if [[ -z "$dbname" || "$dbname" == "null" ]]; then
        echo "Error: srv/$ref/default.php has no dbname (return an \Ema\Config\DatabaseConfig with dbname set)" >&2
        exit 1
    fi
    srv_dir=$(echo "$defs" | jq -r '.dir')
    deps_json=$(echo "$defs" | jq -c '.dependencies')
    key="$(_instance_key "$target")"
    local deps=()
    mapfile -t deps < <(echo "$deps_json" | jq -r '.[]')
    _sandbox_build "$key" "$dbname" "$srv_dir" "${deps[@]}"
}

# Build a sandbox for a pkg/<pkg>-<GUID> schema package.
_sandbox_pkg() {
    local target="$1" key dbname
    key="$(_instance_key "$target")"
    dbname="$(_instance_name "$key")"
    _sandbox_build "$key" "$dbname" "" "$key"
}

# Shared sandbox build driver (create-only). <srv_dir> is the srv/ package
# dir for a database sandbox (bootstrap read from its upgrade.sql), or "" to
# synthesize a default bootstrap. <deps> are the schema-package graph roots.
# Refuses when the instance already exists: sandboxes are disposable — gc
# first, then rebuild.
_sandbox_build() {
    local key="$1" dbname="$2" srv_dir="$3"
    shift 3
    local deps=("$@")
    local datadir workdir sql
    datadir="$(_sandbox_data "$key")"
    if [[ -d "$datadir" ]]; then
        echo "Error: sandbox '$key' already built — ema sandbox is create-only (run 'ema gc var/sandbox/$key' first)" >&2
        exit 1
    fi
    mkdir -p "$(_sandbox_dir "$key")"
    _write_sandbox_ini "$key" "$dbname"
    mkdir -p "$datadir"
    if ! mariadb-install-db --auth-root-authentication-method=normal --skip-test-db \
            --datadir="$PWD/$datadir" --pid-file="$PWD/$(_sandbox_pid "$key")" >/dev/null 2>&1; then
        echo "Error: mariadb-install-db failed for '$key'" >&2
        exit 1
    fi
    _sandbox_start "$key" "yes" || exit 1
    # The instance's own connection file (written by _write_sandbox_ini above):
    # a sandbox build knows its side and never consults EMA_TARGET.
    _load_section "$(_sandbox_ini "$key")" "$dbname"
    _mariadb_args
    workdir=$(mktemp -d /tmp/ema_bootstrap_XXXXXX)
    sql="${workdir}/bootstrap.sql"
    if [[ -n "$srv_dir" ]]; then
        _build_srv_bootstrap_sql "$srv_dir" "$sql"
    else
        _build_synth_bootstrap_sql "$dbname" "utf8" "utf8_spanish_ci" "$sql"
    fi
    _run_root_sql "" "$sql"
    rm -r "$workdir"
    if [[ "${#deps[@]}" -gt 0 ]]; then
        _apply_pkg_graph "$dbname" "${deps[@]}"
    fi
    _maybe_open_shell "$dbname"
}

_help_gc() {
    cat <<'HELP'
Usage: ema gc [<path>] [flags]

Remove stopped sandbox instances under var/sandbox/ (sandbox instances only).

With a path (var/sandbox/<name>-<guid>, as printed by 'ema status') only that
instance is considered; with no argument every instance is. Each one whose
server is not running is removed in whole (datadir/socket/pid/reuter.ini);
running instances are left alone.

Flags:
  -q, --quiet       Suppress output
HELP
}

_cmd_gc() {
    if _is_help "$@"; then
        _help_gc
        return
    fi
    _parse_flags "-q --quiet -v --verbose" "" "$@"
    local quiet verbose ref
    quiet=$(_get_flag --quiet -q quiet)
    verbose=$(_get_flag --verbose -v verbose)
    _assert_repo_root
    ref="${_POS_ARGS[0]:-}"
    if [[ -n "$ref" ]]; then
        local one
        one="$(_resolve_instance_path "$ref")" || exit 1
        if _sandbox_up "$one"; then
            echo "Error: var/sandbox/$one is running — 'ema stop var/sandbox/$one' first." >&2
            exit 1
        fi
        rm -rf "var/sandbox/$one"
        [[ "$quiet" == "no" ]] && echo "gc: removed var/sandbox/$one"
        return
    fi
    if [[ ! -d "var/sandbox" ]]; then
        [[ "$quiet" == "no" ]] && echo "Nothing to gc."
        return
    fi
    local dirs key found="no" keys=()
    mapfile -t keys < <(ls -d var/sandbox/*/ 2>/dev/null)
    for dirs in "${keys[@]}"; do
        key=$(basename "$dirs")
        if _sandbox_up "$key"; then
            [[ "$verbose" == "yes" ]] && echo "gc: skipping running instance '$key'" >&2
            continue
        fi
        found="yes"
        rm -rf "var/sandbox/$key"
        [[ "$quiet" == "no" ]] && echo "gc: removed var/sandbox/$key"
    done
    if [[ "$found" == "no" && "$quiet" == "no" ]]; then
        echo "Nothing to gc."
    fi
}

_help_status() {
    cat <<'HELP'
Usage: ema status [flags]

List both sides with state:
  sandbox instances: each var/sandbox/<name>-<guid>/ instance, its server
                     up/down, socket endpoint, the age of its reuter.ini, and
                     the instance path
  prod sections:     the prod reuter file's sections, each with its
                     reachability (TCP port, or the socket file for sections
                     that define MYSQL_UNIX_PORT) and the local instance path
                     when the instance exists on this host ('-' otherwise)

The trailing path is the address the lifecycle verbs (start/stop/restart/gc)
take.

Flags:
  -v, --verbose     Verbose output to stderr
HELP
}

_cmd_status() {
    if _is_help "$@"; then
        _help_status
        return
    fi
    _parse_flags "-q --quiet -v --verbose" "" "$@"
    local quiet verbose
    quiet=$(_get_flag --quiet -q quiet)
    verbose=$(_get_flag --verbose -v verbose)
    _assert_repo_root
    echo "Sandbox instances:"
    _status_sandbox
    echo
    echo "Prod sections ($(_prod_reuter_file)):"
    _status_prod
}

_status_sandbox() {
    if [[ ! -d "var/sandbox" ]]; then
        echo "No sandbox instances."
        return
    fi
    local keys=() dirs key
    mapfile -t keys < <(ls -d var/sandbox/*/ 2>/dev/null)
    if [[ ${#keys[@]} -eq 0 ]]; then
        echo "No sandbox instances."
        return
    fi
    for dirs in "${keys[@]}"; do
        key=$(basename "$dirs")
        local pid state endpoint age ini
        ini="$(_sandbox_ini "$key")"
        pid="$(_sandbox_pid_value "$key")"
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            state="up"
        else
            state="dn"
        fi
        endpoint="socket $(_sandbox_sock "$key")"
        age="$(_age "$ini")"
        printf '[%s]  %-2s  %-30s  %-6s  %s\n' "$key" "$state" "$endpoint" "$age" "$(_sandbox_dir "$key")"
    done
}

_status_prod() {
    local reuter
    reuter="$(_prod_reuter_file)"
    if [[ ! -f "$reuter" ]]; then
        echo "No prod sections: $reuter not found."
        return
    fi
    local names
    names=$(php -r "
        \$cnf = parse_ini_file('${reuter}', true);
        if (!\$cnf) exit(0);
        foreach (array_keys(\$cnf) as \$k) echo \$k, PHP_EOL;
    ") || exit 1
    if [[ -z "$names" ]]; then
        echo "No sections in $reuter."
        return
    fi
    local name
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        local vars endpoint state
        vars=$(php -r "
            \$cnf = parse_ini_file('${reuter}', true);
            foreach (['SERVER','PORT','MYSQL_UNIX_PORT'] as \$k)
                if (isset(\$cnf['${name}'][\$k])) echo \$k, '=', escapeshellarg(\$cnf['${name}'][\$k]), PHP_EOL;
        ")
        eval "$vars"
        if [[ -n "${MYSQL_UNIX_PORT:-}" ]]; then
            endpoint="socket $MYSQL_UNIX_PORT"
            if [[ -S "$MYSQL_UNIX_PORT" ]]; then state="up"; else state="dn"; fi
        else
            endpoint="${SERVER:-?}:${PORT:-?}"
            if timeout 2 bash -c "</dev/tcp/$SERVER/$PORT" 2>/dev/null; then state="up"; else state="dn"; fi
        fi
        local path="$_EMA_PROD_BASE/$name"
        [[ -d "$path" ]] || path="-"
        printf '[%s]  %-2s  %-30s  %-6s  %s\n' "$name" "$state" "$endpoint" "-" "$path"
        unset SERVER PORT MYSQL_UNIX_PORT
    done <<< "$names"
}

_list_sandbox_keys() {
    if [[ -d "var/sandbox" ]]; then
        local d
        for d in var/sandbox/*/; do
            [[ -d "$d" ]] && basename "$d"
        done
    fi
}

# Resolve the instance keys a lifecycle command operates on: one key when an
# instance path is given, otherwise every sandbox instance. Callers resolve it
# into a variable before iterating: a refused address must fail the command, and
# a process substitution would swallow that failure.
_lifecycle_keys() {
    local ref="$1"
    if [[ -n "$ref" ]]; then
        _resolve_instance_path "$ref" || return 1
    else
        _list_sandbox_keys
    fi
}

