if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

case "$1" in
    schema)
        shift
        _cmd_schema "$@"
        ;;
    database)
        shift
        _cmd_database "$@"
        ;;
    mariadb)
        shift
        _cmd_mariadb "$@"
        ;;
    sandbox)
        shift
        _cmd_sandbox "$@"
        ;;
    drop)
        shift
        _cmd_drop "$@"
        ;;
    gc)
        shift
        _cmd_gc "$@"
        ;;
    status)
        shift
        _cmd_status "$@"
        ;;
    start)
        shift
        _cmd_start "$@"
        ;;
    stop)
        shift
        _cmd_stop "$@"
        ;;
    restart)
        shift
        _cmd_restart "$@"
        ;;
    inspect)
        shift
        _cmd_inspect "$@"
        ;;
    deps)
