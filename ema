#!/bin/bash

# When installed via nix, EMA_LIB is set by makeWrapper to the share directory.
# When run directly from the repo, fall back to the adjacent src/ directory.
_EMA_LIB="${EMA_LIB:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/src}"

PROGRAM_NAME="ema"

show_help() {
    echo "Usage: $PROGRAM_NAME <command> [arguments]"
    echo ""
    echo "Available commands:"
    echo "  schema <name>                 Create a new schema package in pkg/"
    echo "  mariadb <db> [args...]        Open a MariaDB shell against a database's section"
    echo "  init db <name>                Create database, users, and grants (reads srv/<name>.sql)"
    echo "  init tables <root-pkg> <db>   Apply all schema packages in topological order"
    echo ""
    echo "Options:"
    echo "  -h, --help             Show this help message and exit"
    echo "  -v, --version          Show program version"
    echo ""
    echo "Environment:"
    echo "  EMA_MODE               Machine mode: dev (local sandbox) or prod (default: dev)"
    echo "  REUTER_INI             Prod reuter.ini path (used when EMA_MODE is not dev)"
    echo "  DBUSER                 Default CLI client user for non-local targets (default: \$USER)"
}

show_version() {
    echo "$PROGRAM_NAME version 1.0.0"
}

_assert_repo_root() {
    if [[ ! -d "pkg" ]]; then
        echo "Error: pkg/ not found — run ema from your project root" >&2
        exit 1
    fi
}

# The connection file is chosen by machine mode, not by the command:
#   dev    -> var/reuter.local.ini (dev sandbox, generated by 'ema init db')
#   other  -> $REUTER_INI (fallback etc/reuter.ini; the prod file)
_reuter_file() {
    if [ "${EMA_MODE:-dev}" = "dev" ]; then
        echo "var/reuter.local.ini"
    else
        echo "${REUTER_INI:-etc/reuter.ini}"
    fi
}

# Load the [<dbname>] section (the section header IS the database name).
_load_target() {
    local dbname="$1"
    if [[ -z "$dbname" ]]; then
        echo "Error: a database name is required (the section header is the database name)" >&2
        exit 1
    fi
    local reuter
    reuter="$(_reuter_file)"
    if [[ ! -f "$reuter" ]]; then
        echo "Error: $reuter not found (dev: run 'ema init db <name>'; prod: run gen-reuter)" >&2
        exit 1
    fi
    local vars
    vars=$(php -r "
        \$cnf = parse_ini_file('${reuter}', true);
        if (!\$cnf || !isset(\$cnf['${dbname}'])) {
            fwrite(STDERR, \"Error: section '${dbname}' not found in ${reuter}\n\");
            exit(1);
        }
        foreach (\$cnf['${dbname}'] as \$k => \$v)
            echo \$k . '=' . escapeshellarg(\$v) . PHP_EOL;
    ") || exit 1
    # The section is authoritative: clear any ambient connection vars first so
    # an exported value (e.g. MYSQL_UNIX_PORT from the dev shell) cannot leak
    # into a section that does not define it.
    unset SERVER PORT DBNAME DBMS ADMIN_PASSWORD READER_PASSWORD MYSQL_UNIX_PORT
    eval "$vars"
}

_mariadb_args() {
    if [[ -n "${MYSQL_UNIX_PORT:-}" ]]; then
        _MARIADB_ARGS=("--socket=$MYSQL_UNIX_PORT")
    else
        _MARIADB_ARGS=("-h" "$SERVER")
        [[ -n "${PORT:-}" ]] && _MARIADB_ARGS+=("-P" "$PORT")
    fi
}

schema() {
    if [[ -z "$1" ]]; then
        echo "Error: must provide a name for the schema" >&2
        exit 1
    fi
    _assert_repo_root
    local prefix="$1"
    if ls -d "pkg/${prefix}"-* 1>/dev/null 2>&1; then
        echo "Error: Schema with prefix '$prefix' already exists in pkg/." >&2
        return 1
    fi
    local random_suffix
    random_suffix=$(tr -dc 'A-Z0-9' < /dev/urandom | fold -w 16 | head -n 1)
    local directory_name="${prefix}-${random_suffix}"
    mkdir -p "pkg/${directory_name}"
    touch "pkg/${directory_name}/upgrade.sql"
    cat <<EOD > "pkg/${directory_name}/default.php"
<?php
\$dependencies = array();
?>
EOD
    echo "Directory created: pkg/${directory_name}"
}

_cmd_mariadb() {
    _assert_repo_root
    local dbname="" _args=("$@")
    if [ "${#_args[@]}" -gt 0 ] && [[ "${_args[0]}" != -* ]]; then
        dbname="${_args[0]}"
    fi
    _load_target "$dbname"
    _mariadb_args
    local _db_user
    if [ "${EMA_MODE:-dev}" = "dev" ]; then
        _db_user="root"
    else
        _db_user="${DBUSER:-$USER}"
    fi
    exec "$DBMS" -u "$_db_user" "${_MARIADB_ARGS[@]}" "${_args[@]}"
}

_gen_password() {
    tr -dc 'A-Za-z0-9' < /dev/urandom | fold -w 24 | head -n 1
}

# Ensure var/reuter.local.ini has a [<dbname>] section for the dev sandbox:
# reuse an existing section's credentials, otherwise generate fresh ones and
# append the section.
_ensure_local_section() {
    local name="$1"
    local reuter="var/reuter.local.ini"
    if [[ -f "$reuter" ]] && php -r "
        \$cnf = parse_ini_file('${reuter}', true);
        exit(\$cnf && isset(\$cnf['${name}']) ? 0 : 1);
    " 2>/dev/null; then
        return 0
    fi
    mkdir -p var
    if [[ ! -f "$reuter" ]]; then
        cat > "$reuter" <<'REUTER_LOCAL_EOF'
; Generated by ema — dev sandbox connections (git-ignored, machine-local).
; One [<dbname>] section per local database, same key shape as the prod
; etc/reuter.ini sections. Created/updated by 'ema init db <name>'.
REUTER_LOCAL_EOF
    fi
    {
        printf '\n[%s]\n' "$name"
        printf 'SERVER=localhost\n'
        printf 'PORT=3306\n'
        printf 'DBMS=mariadb\n'
        printf 'MYSQL_UNIX_PORT=var/mariadb/mysql.sock\n'
        printf 'ADMIN_PASSWORD=%s\n' "$(_gen_password)"
        printf 'READER_PASSWORD=%s\n' "$(_gen_password)"
    } >> "$reuter"
}

# Apply srv/<name>.sql with the loaded section's placeholders filled in.
_apply_schema() {
    local name="$1"
    local srv_file="srv/${name}.sql"
    if [[ ! -f "$srv_file" ]]; then
        echo "Error: $srv_file not found" >&2
        exit 1
    fi
    local workdir
    workdir=$(mktemp -d /tmp/db_schemas_XXXXXX)
    local pseudo_sql="${workdir}/pseudo_query.sql"
    local sql="${workdir}/query.sql"
    cat "$srv_file" >> "$pseudo_sql"
    sed "s/{{dbname}}/${name}/g; s/{{servername}}/${SERVER}/g; s/{{admin_password}}/${ADMIN_PASSWORD}/g; s/{{reader_password}}/${READER_PASSWORD}/g;" \
        "$pseudo_sql" > "$sql"
    "$DBMS" -u root "${_MARIADB_ARGS[@]}" < "$sql" 2>/dev/null || \
        sudo env PATH="$PATH" MYSQL_UNIX_PORT="$MYSQL_UNIX_PORT" "$DBMS" -u root "${_MARIADB_ARGS[@]}" < "$sql"
    rm -r "$workdir"
    "$DBMS" -u root "${_MARIADB_ARGS[@]}" "$name" 2>/dev/null || \
        sudo env PATH="$PATH" MYSQL_UNIX_PORT="$MYSQL_UNIX_PORT" "$DBMS" -u root "${_MARIADB_ARGS[@]}" "$name"
}

_cmd_init_db() {
    local name="$1"
    if [[ -z "$name" ]]; then
        echo "Error: must provide a database name (e.g., ema init db mydb)" >&2
        exit 1
    fi
    _assert_repo_root
    # Root is allowed only in prod mode (issue-9 model: SSH to the DB host as
    # root, root/unix_socket auth over the local socket). In dev mode the
    # sandbox (var/) must stay user-owned, so root is refused.
    if [[ $EUID -eq 0 ]] && [ "${EMA_MODE:-dev}" = "dev" ]; then
        echo "Error: execute without sudo." >&2
        exit 1
    fi
    if [ "${EMA_MODE:-dev}" = "dev" ]; then
        _ensure_local_section "$name"
    fi
    _load_target "$name"
    _mariadb_args
    _apply_schema "$name"
}

_cmd_init_tables() {
    local root_pkg="$1" dbname="${2:-}"
    if [[ -z "$root_pkg" ]]; then
        echo "Error: must provide a root package (e.g., ema init tables mypkg-HASH mydb)" >&2
        exit 1
    fi
    _assert_repo_root
    if [[ ! -d "pkg/$root_pkg" ]]; then
        echo "Error: pkg/$root_pkg not found" >&2
        exit 1
    fi
    # Root is allowed only in prod mode (same issue-9 model as init db);
    # dev mode refuses root to keep the dev sandbox user-owned.
    if [[ $EUID -eq 0 ]] && [ "${EMA_MODE:-dev}" = "dev" ]; then
        echo "Error: execute without sudo." >&2
        exit 1
    fi
    _load_target "$dbname"
    _mariadb_args
    local schemas_json
    schemas_json=$(php -r "
        require '${_EMA_LIB}/sort_schemas.php';
        echo json_encode(build_dependency_graph('${root_pkg}')->topological_sort());
    ") || exit 1
    local schemas_array
    mapfile -t schemas_array < <(echo "$schemas_json" | jq -r '.[]')
    local workdir
    workdir=$(mktemp -d /tmp/table_schemas_XXXXXX)
    local pseudo_sql="${workdir}/pseudo_query.sql"
    local sql="${workdir}/query.sql"
    for schema in "${schemas_array[@]}"; do
        cat "pkg/$schema/upgrade.sql" >> "$pseudo_sql"
        echo "" >> "$pseudo_sql"
    done
    { echo "SET FOREIGN_KEY_CHECKS=0;"; \
      sed "s/{{dbname}}/${dbname}/g; s/{{servername}}/${SERVER}/g;" "$pseudo_sql"; \
      echo "SET FOREIGN_KEY_CHECKS=1;"; } > "$sql"
    "$DBMS" -u root "${_MARIADB_ARGS[@]}" "$dbname" < "$sql" 2>/dev/null || \
        sudo env PATH="$PATH" MYSQL_UNIX_PORT="$MYSQL_UNIX_PORT" "$DBMS" -u root "${_MARIADB_ARGS[@]}" "$dbname" < "$sql"
    rm -r "$workdir"
    "$DBMS" -u root "${_MARIADB_ARGS[@]}" "$dbname" -e "SHOW TABLES;" 2>/dev/null || \
        sudo env PATH="$PATH" MYSQL_UNIX_PORT="$MYSQL_UNIX_PORT" "$DBMS" -u root "${_MARIADB_ARGS[@]}" "$dbname" -e "SHOW TABLES;"
}

if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

case "$1" in
    schema)
        shift
        schema "$@"
        ;;
    mariadb)
        shift
        _cmd_mariadb "$@"
        ;;
    init)
        shift
        case "$1" in
            db)
                shift
                _cmd_init_db "$@"
                ;;
            tables)
                shift
                _cmd_init_tables "$@"
                ;;
            *)
                echo "Error: Unknown init subcommand: ${1:-<missing>}" >&2
                show_help
                exit 1
                ;;
        esac
        ;;
    -h|--help)
        show_help
        ;;
    -v|--version)
        show_version
        ;;
    *)
        echo "Error: Unknown command or option: $1" >&2
        show_help
        exit 1
        ;;
esac
