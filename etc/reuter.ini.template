; Reuter file — prod connectivity, one [<dbname>] section per database.
;
; This is a TEMPLATE: copy it to etc/reuter.ini (git-ignored) and fill in
; real values. On prod, gen-reuter writes etc/reuter.ini from machines.ini +
; deploy.conf instead of copying this.
;
; Local dev connections live in var/reuter.local.ini (generated by
; `ema init db <name>`), not here.
;
; Transport: MYSQL_UNIX_PORT is the DB host's local socket path so
; `ema init db <name>` run on the DB host connects as root over the socket;
; the app layer reads .env (not this key) and stays TCP-only.

[mydb]
SERVER=10.147.x.x
PORT=3306
DBMS=mariadb
ADMIN_PASSWORD=change_me
READER_PASSWORD=change_me
MYSQL_UNIX_PORT=/path/to/mysql.sock
