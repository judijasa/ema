{
    "name": "judijasa/ema",
    "description": "Package manager for MariaDB — schema packages + CLI distributed as a Composer library",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ema\\Config\\": "src/Config/"
        }
    },
    "bin": [
        "ema",
        "bin/dev/init-cluster.sh"
    ]
}
